generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// CORE MULTI-TENANT
// ============================================

model Tenant {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  logo         String?
  phone        String?
  email        String?
  address      String?
  city         String?
  state        String?
  rfc          String?
  businessType String?
  themePreset  ThemePreset @default(NEUTRAL_TECH)
  isActive     Boolean     @default(true)

  // Día en que abre la "semana laboral" de ESTE negocio (2026-09-18, a
  // petición explícita de Carlos: "no quiero que sea un sistema cerrado...
  // cada dueño debe poder crear su propio periodo laboral" — antes cada
  // módulo que hablaba de "esta semana" traía su propio criterio
  // improvisado y sin configurar: Dashboard usaba una ventana rodante de 7
  // días terminando hoy, Personal una ventana fija de 8 días, y Asistencia
  // otra ventana rodante de 7 días — ninguna alineada a un día real de
  // corte de nómina, y las tres podían mostrar números distintos entre sí
  // para la misma pregunta. 0=domingo … 6=sábado (mismo índice que
  // DIAS_SEMANA en lib/dashboard-data.ts). Default 1 = lunes, el criterio
  // que ya tenían las pantallas que sí usaban una semana calendario (ISO,
  // lunes a domingo) — así ningún tenant existente cambia de comportamiento
  // hasta que su dueño elija otro día en Configuración. Único punto de
  // verdad: lib/periodo-laboral.ts calcula el rango real a partir de este
  // campo, para que Dashboard/Personal/Asistencia dejen de tener cada uno
  // su propia idea de "semana".
  weekStartDay Int @default(1)

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Límites de capacidad (cuántas sucursales, cuánto personal por sucursal)
  // que Carlos asigna/reasigna desde Panel Maestro — ver modelo PlanEsquema.
  // null = sin esquema asignado = sin límite (así quedan los tenants que ya
  // existían antes de este campo, para no romperles nada de golpe).
  esquemaId String?
  esquema   PlanEsquema? @relation(fields: [esquemaId], references: [id])

  branches     Branch[]
  users        User[]
  modules      TenantModule[]
  subscription Subscription?
  customers    Customer[]
  products     Product[]
  categories   Category[]
  repairs      Repair[]
  sales        Sale[]
  cashSessions CashSession[]
  staff        Staff[]
  suppliers    Supplier[]
  purchases    Purchase[]
  invoices     Invoice[]
  labels       TenantLabel[]
  supportTickets SupportTicket[]
  staffLoginSessions StaffLoginSession[]
  appointments Appointment[]
  patientRecords    PatientRecord[]
  clinicalNotes     ClinicalNote[]
  odontogramaTeeth  OdontogramaTooth[]
  treatmentPlans    TreatmentPlan[]
  informedConsents  InformedConsent[]
  prescriptions     Prescription[]
}

// Textos de UI personalizables por tenant (nombre del módulo, de la entidad,
// de cada estatus, etc.) sobre una clave interna fija que nunca cambia.
// Si un tenant no tiene fila para una key, el resolver cae al default del
// rubro (businessType) y, si tampoco existe, al default genérico del sistema
// — ambos niveles de default viven en código (lib/labels.ts), no en la BD.
model TenantLabel {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
}

enum ThemePreset {
  NEUTRAL_TECH
  BLACK_GOLD
  EMERALD
  CORAL_WARM
  OCEAN_BLUE
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  users        User[]
  inventory    Inventory[]
  repairs      Repair[]
  sales        Sale[]
  cashSessions CashSession[]
  staff        Staff[]
  purchases    Purchase[]
  staffLoginSessions StaffLoginSession[]
  appointments Appointment[]
  treatmentPlans TreatmentPlan[]
}

// ============================================
// SUPERADMIN — PANEL MAESTRO
// ============================================

// Administradores de la plataforma (dueños de Linkity, no de un negocio en
// particular). Separado de User a propósito: User.tenantId es obligatorio
// (todo User pertenece a UN negocio), así que un admin de plataforma no se
// puede modelar como un User más sin volver ese campo opcional en todo el
// resto del sistema. Un superadmin inicia sesión con el mismo Supabase
// Auth que cualquier tenant (mismo login de siempre) — esta tabla es lo
// único que decide si esa sesión tiene permiso de entrar a /maestro/*.
// Se crea/promueve con scripts/set-superadmin.ts (no hay UI para esto
// todavía, a propósito: solo Carlos lo necesita por ahora).
model SuperAdmin {
  id         String   @id @default(cuid())
  supabaseId String   @unique
  email      String   @unique
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  supportMessages SupportTicketMessage[]
}

// ============================================
// M3 - USUARIOS Y AUTENTICACIÓN
// ============================================

model User {
  id         String   @id @default(cuid())
  tenantId   String
  branchId   String?
  email      String
  name       String
  avatarUrl  String?
  supabaseId String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  role         UserRole?
  sales        Sale[]
  repairs      Repair[]
  cashSessions CashSession[]
  // Vínculo opcional con su registro de personal (M11) — permite atribuirle
  // a un empleado específico las ventas/reparaciones que hizo, para poder
  // calcular su comisión individual. No todo Staff tiene cuenta de acceso.
  staff        Staff?
  supportTickets  SupportTicket[]
  supportMessages SupportTicketMessage[]
  appointments    Appointment[]
  clinicalNotesWritten     ClinicalNote[]
  odontogramaTeethUpdated  OdontogramaTooth[]
  treatmentPlansCreated    TreatmentPlan[]
  informedConsentsTaken    InformedConsent[]
  prescriptionsWritten     Prescription[]
  // Nota: StaffLoginSession NO se relaciona con User — apunta directo a
  // Staff, que es la identidad real detrás de una sesión de PIN (ver
  // comentario largo en ese modelo).

  @@unique([tenantId, email])
}

// ============================================
// M4 - ROLES Y PERMISOS
// ============================================

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  userRoles   UserRole[]
  permissions RolePermission[]
  // Empleados de PIN (M11) que tienen este rol asignado — separado de
  // UserRole/userRoles (que es para cuentas con acceso completo vía
  // Supabase Auth: el dueño y, potencialmente, gerentes con correo propio).
  // Ver el comentario largo en Staff.roleId para la explicación completa de
  // por qué un empleado de PIN no usa User/UserRole.
  staff       Staff[]

  @@unique([tenantId, name])
}

model Permission {
  id          String  @id @default(cuid())
  module      String
  action      String
  description String?

  roles RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String @unique
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])
}

// ============================================
// M0 - MÓDULOS Y SUSCRIPCIONES
// ============================================

model Module {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isCore      Boolean @default(false)

  tenants TenantModule[]
}

model TenantModule {
  tenantId  String
  moduleId  String
  isActive  Boolean  @default(true)
  enabledAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@id([tenantId, moduleId])
}

model Subscription {
  id        String             @id @default(cuid())
  tenantId  String             @unique
  plan      String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  price     Decimal            @db.Decimal(10, 2)
  currency  String             @default("MXN")
  // Vigencia contratada (1/3/6/12 meses) y si el cliente activó cobro
  // recurrente — de esto depende qué recordatorio le corresponde cerca
  // del vencimiento (aviso de próximo cobro automático vs. aviso de que
  // debe renovar a mano). El cálculo/envío de esos recordatorios y el
  // panel de vigencias en Panel Maestro son trabajo aparte, todavía no
  // construido — este cambio solo guarda los datos que ese trabajo va a
  // necesitar.
  billingCycle BillingCycle    @default(MENSUAL)
  autoRenew    Boolean         @default(false)

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  TRIAL
}

/**
 * Esquema de capacidad (2026-09) — reemplaza la idea de "el cliente elige
 * su plan" en el registro público: ahora el cobro y los paquetes/usuarios
 * adicionales los gestiona Hotmart por fuera de la plataforma, y aquí
 * dentro Carlos define cuántas sucursales y cuánto personal por sucursal
 * puede tener cada negocio — configurable desde Panel Maestro
 * (/maestro/esquemas), y reasignable en cualquier momento por tenant desde
 * su pantalla de detalle, para poder "migrar" a un cliente de esquema
 * según el volumen que vaya necesitando, sin tocar código ni base de datos
 * a mano.
 *
 * `isDefault` marca el esquema que se asigna automáticamente a un negocio
 * nuevo que se auto-registra (solo debe haber uno con isDefault=true a la
 * vez — las acciones en maestro/esquemas/actions.ts se encargan de eso).
 * `isActive=false` es un soft-delete: no se borra un esquema que ya tenga
 * tenants asignados (rompería su referencia), solo se oculta de la lista
 * para asignar esquemas nuevos.
 */
model PlanEsquema {
  id                String   @id @default(cuid())
  name              String
  maxBranches       Int
  maxStaffPerBranch Int
  isDefault         Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenants Tenant[]
}

enum BillingCycle {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

// ============================================
// M6 - CATÁLOGO
// ============================================

model Category {
  id       String       @id @default(cuid())
  tenantId String
  name     String
  type     CategoryType
  color    String?
  parentId String?

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

enum CategoryType {
  PRODUCT
  PART
  SERVICE
}

model Product {
  id          String      @id @default(cuid())
  tenantId    String
  categoryId  String?
  sku         String?
  barcode     String?
  name        String
  description String?
  type        ProductType
  price       Decimal     @db.Decimal(10, 2)
  cost        Decimal?    @db.Decimal(10, 2)
  taxRate     Decimal     @default(16) @db.Decimal(5, 2)
  emoji       String?
  metadata    Json?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  category      Category?      @relation(fields: [categoryId], references: [id])
  inventory     Inventory[]
  saleItems     SaleItem[]
  repairItems   RepairItem[]
  purchaseItems PurchaseItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
}

enum ProductType {
  PRODUCT
  PART
  SERVICE
}

// ============================================
// M12 - INVENTARIO
// ============================================

model Inventory {
  id        String   @id @default(cuid())
  productId String
  branchId  String
  stock     Int      @default(0)
  minStock  Int      @default(0)
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([productId, branchId])
}

// ============================================
// M7 - CLIENTES
// ============================================

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  // Código de país del teléfono (ej. "+52", "+1") — lib/paises.ts trae el
  // catálogo. Default México porque es donde opera el negocio hoy; los
  // clientes creados antes de este campo quedan igual (México) al aplicar
  // el default vía `db push`, no hace falta backfill manual.
  phoneCountryCode String @default("+52")
  email     String?
  rfc       String?
  address   String?
  points    Int      @default(0)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  sales        Sale[]
  repairs      Repair[]
  invoices     Invoice[]
  appointments Appointment[]
  patientRecord    PatientRecord?
  clinicalNotes    ClinicalNote[]
  odontogramaTeeth OdontogramaTooth[]
  treatmentPlans   TreatmentPlan[]
  informedConsents InformedConsent[]
  prescriptions    Prescription[]
}

// ============================================
// M8 - PUNTO DE VENTA
// ============================================

model Sale {
  id            String        @id @default(cuid())
  tenantId      String
  branchId      String
  customerId    String?
  userId        String
  folio         String
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  notes         String?
  metadata      Json?
  createdAt     DateTime      @default(now())

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  branch        Branch             @relation(fields: [branchId], references: [id])
  customer      Customer?          @relation(fields: [customerId], references: [id])
  user          User               @relation(fields: [userId], references: [id])
  items         SaleItem[]
  invoice       Invoice?
  mixedPayments SaleMixedPayment[]

  @@unique([tenantId, folio])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)

  sale    Sale    @relation(fields: [saleId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

// Desglose de una venta con método de pago "Mixto": un renglón por cada
// método realmente utilizado (ej. parte en efectivo, parte con tarjeta).
model SaleMixedPayment {
  id     String             @id @default(cuid())
  saleId String
  method MixedPaymentMethod
  amount Decimal            @db.Decimal(10, 2)

  sale Sale @relation(fields: [saleId], references: [id])
}

enum MixedPaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MIXED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

// ============================================
// M9 - TALLER Y REPARACIONES
// ============================================

model Repair {
  id            String       @id @default(cuid())
  tenantId      String
  branchId      String
  customerId    String
  userId        String
  folio         String
  deviceBrand   String
  deviceModel   String
  deviceSerial  String?
  issueDesc     String
  diagnosisDesc String?
  status        RepairStatus @default(RECEIVED)
  priority      Priority     @default(NORMAL)
  estimatedCost Decimal?     @db.Decimal(10, 2)
  finalCost     Decimal?     @db.Decimal(10, 2)
  receivedAt    DateTime     @default(now())
  estimatedAt   DateTime?
  deliveredAt   DateTime?
  publicToken   String       @unique @default(cuid())
  whatsappSent  Boolean      @default(false)
  notes         String?

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  branch   Branch          @relation(fields: [branchId], references: [id])
  customer Customer        @relation(fields: [customerId], references: [id])
  user     User            @relation(fields: [userId], references: [id])
  items    RepairItem[]
  history  RepairHistory[]

  @@unique([tenantId, folio])
}

model RepairItem {
  id        String  @id @default(cuid())
  repairId  String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  repair  Repair  @relation(fields: [repairId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model RepairHistory {
  id        String       @id @default(cuid())
  repairId  String
  status    RepairStatus
  notes     String?
  createdAt DateTime     @default(now())

  repair Repair @relation(fields: [repairId], references: [id])
}

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  WAITING_PARTS
  IN_REPAIR
  READY
  DELIVERED
  CANCELLED
  WORKSHOP_READY
  WORKSHOP_RETURN
  SHOP_READY
  SHOP_RETURN
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ============================================
// M10 - CAJA
// ============================================

model CashSession {
  id           String            @id @default(cuid())
  tenantId     String
  branchId     String
  userId       String
  openingCash  Decimal           @db.Decimal(10, 2)
  closingCash  Decimal?          @db.Decimal(10, 2)
  expectedCash Decimal?          @db.Decimal(10, 2)
  difference   Decimal?          @db.Decimal(10, 2)
  status       CashSessionStatus @default(OPEN)
  openedAt     DateTime          @default(now())
  closedAt     DateTime?
  notes        String?

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  branch    Branch         @relation(fields: [branchId], references: [id])
  user      User           @relation(fields: [userId], references: [id])
  movements CashMovement[]
}

model CashMovement {
  id            String       @id @default(cuid())
  cashSessionId String
  type          MovementType
  amount        Decimal      @db.Decimal(10, 2)
  concept       String
  createdAt     DateTime     @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id])
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum MovementType {
  INCOME
  EXPENSE
}

// ============================================
// M11 - PERSONAL
// ============================================

model Staff {
  id       String  @id @default(cuid())
  tenantId String
  branchId String
  // Cuenta interna de atribución (SIEMPRE se crea desde M11 en adelante,
  // por eso sigue siendo User y no Staff el que aparece en Sale.userId/
  // Repair.userId/CashSession.userId — cambiar esas 3 llaves foráneas para
  // apuntar a Staff habría sido una migración mucho más invasiva). Esta
  // cuenta NO es una cuenta de acceso real: se crea con un correo sintético
  // que nadie ve y un supabaseId inventado (nunca corresponde a una cuenta
  // real de Supabase Auth), así que jamás se puede usar para entrar por
  // /login — el empleado entra exclusivamente por /[tenant]/entrada con su
  // PIN (ver lib/staff-auth.ts). Sigue siendo opcional (`?`) solo por
  // compatibilidad con Staff sembrado antes de este cambio.
  userId   String? @unique
  name     String
  phone    String?
  email    String?
  position String?
  // PIN de 4 dígitos con el que el empleado entra a /[tenant]/entrada —
  // guardado con scrypt (lib/staff-auth.ts), nunca en texto plano. Null en
  // empleados que todavía no tienen PIN asignado (Staff sembrado antes de
  // este cambio, o un empleado que Carlos deliberadamente deja sin acceso
  // al sistema).
  pinHash  String?
  // Rol que determina a qué módulos puede entrar este empleado (ver
  // lib/roles.ts) — deliberadamente separado de Role.userRoles/UserRole
  // (que es para el dueño y cualquier cuenta con acceso completo vía
  // Supabase Auth). "Administrador" nunca se ofrece aquí como opción: ese
  // nivel de acceso solo existe a través de una cuenta real, no de un PIN.
  roleId   String?
  role     Role?   @relation(fields: [roleId], references: [id])

  // Código de país del teléfono (mismo patrón que Customer.phoneCountryCode,
  // ver lib/paises.ts) — 2026-09-17: antes el teléfono era texto libre sin
  // validar longitud, lo que permitía capturar más de los 10 dígitos que
  // exige México. Default México porque todo Staff creado antes de este
  // cambio opera ahí.
  phoneCountryCode String @default("+52")

  // Esquema de pago — 2026-09-17 (diversificación de puestos/rubros a
  // petición de Carlos): se agregó DESTAJO a PaymentScheme (pieceRate,
  // abajo) y se separó la frecuencia del sueldo de la de la comisión
  // (paymentFrequency ahora significa específicamente "frecuencia del
  // sueldo base"; commissionFrequency es la nueva, propia de la comisión —
  // ej. sueldo fijo semanal + comisión mensual, caso real que reportó
  // Carlos). Se agregó además un SEGUNDO par de comisión
  // (teamCommissionRate/teamCommissionBase) para el "jefe de equipo" que
  // cobra su propia comisión individual MÁS una comisión extra por
  // supervisar a los demás (ej. Jefe de Barberos) — calculada sobre la
  // producción de TODA la sucursal del empleado, no sobre una lista
  // explícita de "quién le reporta a quién" (simplificación deliberada: no
  // existe un organigrama en el sistema, y modelarlo sería un proyecto
  // aparte). teamCommissionBase null = "no lidera un equipo".
  paymentScheme       PaymentScheme    @default(FIJO)
  baseSalary          Decimal          @db.Decimal(10, 2)
  commissionRate      Decimal          @default(0) @db.Decimal(5, 2)
  commissionBase      CommissionBase   @default(VENTAS)
  paymentFrequency    PaymentFrequency @default(QUINCENAL)
  commissionFrequency PaymentFrequency @default(QUINCENAL)
  // Monto fijo por unidad de trabajo ("salario por unidad de obra" /
  // destajo) — solo tiene efecto cuando paymentScheme = DESTAJO. Qué cuenta
  // como "una unidad" lo decide commissionBase (VENTAS = por venta,
  // REPARACIONES = por reparación entregada); UTILIDAD no aplica a destajo.
  pieceRate           Decimal          @default(0) @db.Decimal(10, 2)
  teamCommissionRate  Decimal          @default(0) @db.Decimal(5, 2)
  teamCommissionBase  CommissionBase?
  // Método con el que se le paga a este empleado — determina si clabe es
  // obligatoria (ver validarDatosEmpleado en personal-actions.ts). Nombre
  // distinto de PaymentMethod (que ya existe para Sale.paymentMethod: CASH/
  // CARD/TRANSFER/MIXED, un catálogo de POS, no de nómina) para no pisar ese
  // enum ni forzarle valores que no le corresponden.
  staffPaymentMethod  StaffPaymentMethod @default(EFECTIVO)
  // CLABE interbancaria (18 dígitos exactos) — antes se asumía que TODA la
  // nómina se pagaba así; ahora solo se valida/exige cuando
  // staffPaymentMethod = TRANSFERENCIA (ver validarDatosEmpleado).
  clabe            String?

  hiredAt  DateTime @default(now())
  isActive Boolean  @default(true)

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  branch     Branch         @relation(fields: [branchId], references: [id])
  user       User?          @relation(fields: [userId], references: [id])
  attendances Attendance[]
  payments   StaffPayment[]
  loginSessions StaffLoginSession[]
}

enum PaymentScheme {
  FIJO
  COMISION
  MIXTO
  // Destajo / pago por unidad de obra (2026-09-17) — monto fijo por venta o
  // reparación entregada (Staff.pieceRate), no un porcentaje. Concepto real
  // y reconocido en la legislación laboral mexicana ("salario por unidad de
  // obra"), distinto de COMISION (que siempre es % sobre un monto).
  DESTAJO
}

enum CommissionBase {
  VENTAS
  REPARACIONES
  UTILIDAD
}

enum PaymentFrequency {
  SEMANAL
  // Catorcenal (cada 14 días) — 2026-09-17: frecuencia de nómina real y de
  // uso común en México junto con semanal/quincenal/mensual, agregada a
  // petición de Carlos para no excluir a negocios que pagan así.
  CATORCENAL
  QUINCENAL
  MENSUAL
}

// Método de pago de NÓMINA (Staff.staffPaymentMethod) — catálogo aparte del
// PaymentMethod de Sale (CASH/CARD/TRANSFER/MIXED, pensado para cobro en
// punto de venta). TRANSFERENCIA agrupa a propósito transferencia
// electrónica/SPEI y depósito bancario bajo un mismo valor: para efectos de
// este sistema (¿hay que pedir CLABE o no?) son el mismo caso.
enum StaffPaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  TARJETA_NOMINA
  OTRO
}

model Attendance {
  id       String    @id @default(cuid())
  staffId  String
  date     DateTime  @db.Date
  checkIn  DateTime?
  checkOut DateTime?
  notes    String?

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
}

// Bitácora de asistencia basada en el login/logout REAL de personal por PIN
// (2026-09-16, a petición de Carlos). A propósito un modelo aparte de
// Attendance (arriba): Attendance es el registro MANUAL que ya alimenta
// horasSemana/nómina en Personal (un botón "Registrar entrada/salida" que
// cualquiera puede apretar sin estar realmente usando el sistema) — Carlos
// decidió dejarlo tal cual, sin tocar nómina, y que este nuevo panel de
// asistencia (/[tenant]/asistencia, solo visible para el administrador) sea
// puramente informativo y aparte, basado en cuándo el empleado de verdad
// entró/salió del sistema con su PIN.
//
// Una fila por CADA sesión de PIN (no una por día): un mismo empleado puede
// tener varios login/logout el mismo día (turno partido, o simplemente
// volver a entrar tras cerrar sesión) — por eso NO lleva un @@unique por
// día como Attendance. checkOut queda null mientras la sesión sigue
// abierta; se cierra por 3 caminos: (1) el empleado presiona "Cambiar de
// usuario" (closedBy MANUAL, ver cerrarSesionPersonalAction en
// acceso-personal-actions.ts), (2) el administrador la cierra a mano desde
// el panel (closedBy MANUAL también — ver cerrarAsistenciaManualAction en
// asistencia-actions.ts), o (3) el sistema detecta que ya es otro día
// calendario (México) la próxima vez que esa sesión intenta usarse, y la
// cierra sola en el instante justo antes de medianoche del día en que iba
// (closedBy DATE_ROLLOVER) — así nunca queda "abierta" más de un día,
// aunque el empleado deje la pestaña abierta o no cierre sesión (ver
// verificarSesionPersonalVigente en lib/asistencia.ts, que reemplaza a
// leerSesionPersonal en los dos lugares que validan esta sesión: el layout
// del tenant y resolverActor).
model StaffLoginSession {
  id        String                  @id @default(cuid())
  tenantId  String
  staffId   String
  branchId  String
  checkIn   DateTime                @default(now())
  checkOut  DateTime?
  closedBy  StaffLoginCloseReason?
  createdAt DateTime                @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  staff  Staff  @relation(fields: [staffId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
}

enum StaffLoginCloseReason {
  MANUAL
  DATE_ROLLOVER
}

// Pagos de nómina efectivamente generados/dispersados a cada miembro del personal.
model StaffPayment {
  id               String             @id @default(cuid())
  staffId          String
  periodStart      DateTime           @db.Date
  periodEnd        DateTime           @db.Date
  baseAmount       Decimal            @db.Decimal(10, 2)
  commissionAmount Decimal            @default(0) @db.Decimal(10, 2)
  total            Decimal            @db.Decimal(10, 2)
  status           StaffPaymentStatus @default(PENDING)
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime           @default(now())

  staff Staff @relation(fields: [staffId], references: [id])
}

enum StaffPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

// ============================================
// M12 - PROVEEDORES Y COMPRAS
// ============================================

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  rfc       String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  purchases Purchase[]
}

model Purchase {
  id         String         @id @default(cuid())
  tenantId   String
  supplierId String
  // Sucursal a la que se incrementa el Inventory cuando la compra pasa a
  // RECIBIDA. Opcional (no `branchId String` a secas) por la misma razón
  // que Staff.userId se dejó opcional: ya existe al menos una Purchase
  // sembrada (seed.ts) sin este campo, y agregarlo como requerido habría
  // disparado una advertencia de pérdida de datos en `prisma db push`. Toda
  // Purchase NUEVA sí exige branchId desde la Server Action
  // (crearCompraAction en compras-actions.ts) — el null solo puede
  // sobrevivir en registros sembrados antes de este cambio.
  branchId   String?
  folio      String
  total      Decimal        @db.Decimal(10, 2)
  status     PurchaseStatus @default(PENDING)
  notes      String?
  createdAt  DateTime       @default(now())
  // Cuándo se marcó como recibida (dispara el incremento de Inventory) —
  // mismo patrón que Repair.deliveredAt / CashSession.closedAt: un
  // timestamp de "cuándo pasó" además del status en sí.
  receivedAt DateTime?

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  branch   Branch?        @relation(fields: [branchId], references: [id])
  items    PurchaseItem[]

  @@unique([tenantId, folio])
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  cost       Decimal @db.Decimal(10, 2)
  subtotal   Decimal @db.Decimal(10, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

// ============================================
// M14 - FACTURACIÓN CFDI
// ============================================

model Invoice {
  id         String        @id @default(cuid())
  tenantId   String
  customerId String
  saleId     String?       @unique
  folio      String
  uuid       String?       @unique
  cfdiXml    String?
  cfdiPdf    String?
  status     InvoiceStatus @default(PENDING)
  total      Decimal       @db.Decimal(10, 2)
  createdAt  DateTime      @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  sale     Sale?    @relation(fields: [saleId], references: [id])

  @@unique([tenantId, folio])
}

enum InvoiceStatus {
  PENDING
  STAMPED
  CANCELLED
}

// ============================================
// SOPORTE — TICKETS ENTRE NEGOCIO Y PANEL MAESTRO
// ============================================

// Un ticket lo abre siempre un User de negocio (nunca un SuperAdmin), pero
// cualquiera de los dos lados puede escribir mensajes dentro de él — por
// eso SupportTicketMessage tiene userId/superAdminId opcionales (uno u
// otro, nunca ambos; validado en la Server Action, no en el schema).
model SupportTicket {
  id       String              @id @default(cuid())
  tenantId String
  userId   String
  subject  String
  status   SupportTicketStatus @default(OPEN)
  // Reutiliza el mismo enum Priority de Reparaciones (M9) en vez de crear
  // uno nuevo — incluso valores como URGENT ya tienen sentido para un
  // ticket de soporte.
  priority  Priority @default(NORMAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt  DateTime?

  tenant   Tenant                 @relation(fields: [tenantId], references: [id])
  user     User                   @relation(fields: [userId], references: [id])
  messages SupportTicketMessage[]
}

model SupportTicketMessage {
  id           String   @id @default(cuid())
  ticketId     String
  userId       String?
  superAdminId String?
  body         String
  createdAt    DateTime @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  user       User?         @relation(fields: [userId], references: [id])
  superAdmin SuperAdmin?   @relation(fields: [superAdminId], references: [id])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ============================================
// M15 - CITAS (AGENDA) — Fase 1 de "Propuesta: Consultorio Dental para
// Linkity" (2026-09-18): el módulo de Reparaciones no le sirve a un negocio
// de cita (dentista, médico, veterinaria, estética, spa, gimnasio, tatuajes,
// barbería) porque pide marca/modelo/falla de un APARATO — esos negocios
// necesitan agendar la atención de un PACIENTE/CLIENTE en un horario. Sigue
// el mismo patrón multi-tenant que Repair/Sale (tenantId propio, folio NO
// necesario aquí porque una cita no se factura por sí misma — ver notes de
// abajo). `userId` es la cuenta de atribución del profesional que atiende
// la cita, mismo criterio que Repair.userId/Sale.userId (ver el comentario
// largo en Staff.userId): en modo "staff" (sesión de PIN) resolverActor ya
// entrega el userId correcto, así que esta cita se puede atribuir a
// cualquier doctor/estilista/entrenador con PIN, no solo al dueño.
model Appointment {
  id         String            @id @default(cuid())
  tenantId   String
  branchId   String
  customerId String
  userId     String
  // Motivo breve de la cita (ej. "Limpieza dental", "Consulta general",
  // "Corte de cabello") — texto libre a propósito: a diferencia de
  // Repair.issueDesc (una falla reportada), aquí no hay un catálogo fijo de
  // motivos que aplique por igual a los 8 rubros de cita.
  reason    String
  status    AppointmentStatus @default(SCHEDULED)
  startsAt  DateTime
  endsAt    DateTime
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

// ============================================
// M16 - EXPEDIENTE CLÍNICO Y ODONTOGRAMA — Fase 1 de "Propuesta: Consultorio
// Dental para Linkity" (2026-09-18), items 2 y 3 del roadmap acordado con
// Carlos (después de M15-Citas). Cubre el mínimo que pide
// NOM-004-SSA3-2012 para un expediente clínico: antecedentes del paciente
// (una ficha que se acumula, no una por consulta) + notas de evolución (una
// por consulta/cita). El odontograma usa notación FDI de dos dígitos
// (cuadrante 1-4 + posición 1-8, ej. 11 = incisivo central superior
// derecho) — el estándar con el que cualquier dentista mexicano ya lee un
// odontograma en papel.
//
// Un solo módulo ("expediente-clinico", ver lib/modules-catalog.ts) cubre
// ambas piezas: no todo negocio de cita necesita el odontograma (dientes),
// pero antecedentes + notas de evolución sí le sirven a cualquier negocio
// de tipo consulta (médico, veterinaria), así que separarlo en dos módulos
// habría sido sobre-ingeniería para lo que pide esta fase — el odontograma
// simplemente no se muestra en la UI para un negocio cuyo businessType no
// es "consultorio_dental" (ver ClientesClient.tsx), sin necesidad de un
// segundo toggle. Todo vive embebido en la ficha del cliente (módulo
// Clientes, M7), no en una ruta propia — por eso ninguno de estos 3
// modelos necesita folio ni aparece en TenantShell.tsx como link de menú
// aparte.
model PatientRecord {
  id       String @id @default(cuid())
  tenantId String
  // Un expediente por paciente (no por cita) — se va acumulando con el
  // tiempo, de ahí el @unique en vez de permitir varios por Customer.
  customerId String @unique

  bloodType          String?
  allergies          String?
  chronicConditions  String?
  currentMedications String?
  previousSurgeries  String?
  familyHistory      String?
  generalNotes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
}

// Notas de evolución — una fila por consulta/visita, a diferencia de
// PatientRecord (un solo registro acumulado). `userId` es la cuenta de
// atribución del doctor/profesional que la escribió, mismo criterio que
// Appointment.userId/Repair.userId (ver el comentario largo en
// Staff.userId): cualquier doctor con PIN puede quedar como autor, no solo
// el dueño.
model ClinicalNote {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  userId     String
  reason     String
  diagnosis  String?
  treatment  String?
  notes      String?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

// Estado ACTUAL de cada diente del paciente — no existe una fila por cada
// diente de entrada: solo se crea/actualiza (upsert) cuando alguien cambia
// su condición desde "sano" (el default implícito que asume la UI cuando
// no hay fila, mismo criterio "sin fila = default" que ya usa TenantModule
// en este proyecto). `toothNumber` es el número FDI de dos dígitos
// (11-18, 21-28, 31-38, 41-48 para dentición permanente — Fase 1 no cubre
// dentición temporal/infantil, fuera de alcance de esta primera versión).
model OdontogramaTooth {
  id            String         @id @default(cuid())
  tenantId      String
  customerId    String
  toothNumber   Int
  condition     ToothCondition @default(SANO)
  notes         String?
  updatedAt     DateTime       @updatedAt
  updatedByUserId String?

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  updatedBy User?    @relation(fields: [updatedByUserId], references: [id])

  @@unique([customerId, toothNumber])
}

enum ToothCondition {
  SANO
  CARIES
  OBTURADO
  CORONA
  ENDODONCIA
  AUSENTE
  EXTRACCION_INDICADA
  IMPLANTE
  FRACTURADO
  SELLANTE
}

// ============================================
// M17 - PLAN DE TRATAMIENTO, CONSENTIMIENTO INFORMADO Y RECETAS — Fase 2 de
// "Propuesta: Consultorio Dental para Linkity" (2026-09-18), tres de los
// cuatro puntos de "Diferenciación comercial" (el cuarto, Reportes
// clínicos, no necesita modelos nuevos — lee estos de aquí). Igual que
// M16, vive embebido en la ficha del cliente (módulo Clientes, M7) bajo el
// mismo módulo "expediente-clinico" — no es exclusivo de consultorio
// dental (un consultorio médico también cotiza tratamientos por fases y
// receta medicamentos; una veterinaria también receta), así que ninguno de
// los 3 se condiciona a `businessType === "consultorio_dental"` como sí
// pasa con OdontogramaTooth arriba.
model TreatmentPlan {
  id         String   @id @default(cuid())
  tenantId   String
  // Igual que Repair/Appointment: fija en qué sucursal se cobra cada fase
  // (busca la CashSession abierta de ESA sucursal, ver
  // cobrarItemPlanAction en tratamiento-actions.ts) — no hace falta elegir
  // sucursal en cada cobro individual.
  branchId   String
  customerId String
  // Doctor que propone el plan — cuenta de atribución, mismo criterio que
  // ClinicalNote.userId/Appointment.userId (ver Staff.userId).
  userId     String
  title      String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  branch   Branch              @relation(fields: [branchId], references: [id])
  customer Customer            @relation(fields: [customerId], references: [id])
  user     User                @relation(fields: [userId], references: [id])
  items    TreatmentPlanItem[]
}

// No hay status a nivel TreatmentPlan a propósito: la propuesta pide dar
// seguimiento a "qué propone el doctor vs. qué acepta el paciente"
// FASE POR FASE (ej. el paciente acepta la limpieza pero rechaza la
// corona) — un status único por plan perdería esa granularidad, así que
// PROPUESTO/ACEPTADO/RECHAZADO/PAGADO vive en cada item, y "tasa de
// aceptación" (Reportes clínicos) se calcula sobre items, no sobre planes.
//
// Sin tenantId propio ni entrada en getTenantPrisma/tenantModels (mismo
// criterio que RepairItem/SaleItem, ver el comentario largo de
// tenantModels en lib/prisma.ts): siempre se lee/escribe a través de un
// TreatmentPlan ya aislado por tenant, nunca por su cuenta.
model TreatmentPlanItem {
  id              String                  @id @default(cuid())
  treatmentPlanId String
  description     String
  // FDI, igual que OdontogramaTooth.toothNumber — opcional porque no todo
  // tratamiento es de un diente específico (ej. "Ortodoncia completa",
  // "Limpieza general").
  toothNumber     Int?
  cost            Decimal                 @db.Decimal(10, 2)
  status          TreatmentPlanItemStatus @default(PROPUESTO)
  order           Int                     @default(0)
  paidAt          DateTime?
  // Mismo enum PaymentMethod que ya usa Sale — es la misma "caja física"
  // del negocio la que recibe este cobro (ver cobrarTreatmentPlanItemAction
  // en expediente-actions.ts, calcado de cobrarYEntregarAction de
  // Reparaciones: solo CASH genera un CashMovement real).
  paymentMethod   PaymentMethod?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  treatmentPlan TreatmentPlan @relation(fields: [treatmentPlanId], references: [id])
}

enum TreatmentPlanItemStatus {
  PROPUESTO
  ACEPTADO
  RECHAZADO
  PAGADO
}

// Consentimiento informado — NOM-004 lo exige para procedimientos con
// riesgo. `content` es el texto de la plantilla YA COPIADO al momento de
// generar el consentimiento (no una referencia a la plantilla): si Carlos
// edita el texto de una plantilla después, los consentimientos ya firmados
// no deben cambiar retroactivamente — es un documento legal congelado en
// el tiempo, igual que una factura ya timbrada no cambia si el catálogo de
// productos cambia después.
//
// `patientSignature` es una FIRMA DIBUJADA (canvas, PNG en base64) — no es
// una firma electrónica avanzada / e.firma del SAT ni tiene validez legal
// equivalente a una firma autógrafa notariada. Mismo criterio de
// "simulación honesta y documentada" que ya usa Linkity para CFDI (sin
// PAC/SAT real) — se lo advertimos a Carlos explícitamente, no es letra
// chica escondida.
model InformedConsent {
  id             String    @id @default(cuid())
  tenantId       String
  customerId     String
  userId         String
  procedureType  String
  content        String
  patientSignature String?
  signedByName   String?
  signedAt       DateTime?
  createdAt      DateTime  @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

// Receta digital. `medications` queda como texto libre (no una tabla
// estructurada de medicamento+dosis+frecuencia) — mismo criterio que
// ClinicalNote.notes: modelar eso a detalle es sobreingeniería para lo que
// pide esta fase, y un doctor ya está acostumbrado a escribir una receta
// como texto corrido. `doctorSignature` es la misma firma dibujada
// simulada que InformedConsent.patientSignature, ver ese comentario.
model Prescription {
  id               String   @id @default(cuid())
  tenantId         String
  customerId       String
  userId           String
  medications      String
  indications      String?
  doctorSignature  String?
  createdAt        DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}