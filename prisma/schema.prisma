generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// CORE MULTI-TENANT
// ============================================

model Tenant {
  id           String      @id @default(cuid())
  name         String
  slug         String      @unique
  logo         String?
  phone        String?
  email        String?
  address      String?
  city         String?
  state        String?
  rfc          String?
  businessType String?
  // 2026-09-26, a petición de Carlos ("¿existe un apartado para
  // personalizar el ticket?"): mensaje libre que reemplaza el pie fijo
  // "¡Gracias por tu preferencia!" de lib/recibo-imprimible.ts — null usa
  // ese texto de siempre (sin regresión para ningún negocio existente). El
  // resto de los datos del ticket (nombre real, logo, dirección, teléfono,
  // RFC) NO son campos nuevos: ya existían arriba en este mismo modelo, lo
  // que faltaba era que recibo-imprimible.ts los usara en vez de derivar un
  // nombre del slug de la URL — ver el comentario largo ahí.
  reciboMensajePie String?
  // 2026-09-26, a petición de Carlos: "agrega un cuadro de texto abierto
  // para que el cliente pueda poner texto a su gusto, sin limite de
  // caracteres... ahi puede meter direcciones, promociones, un saludo, lo
  // que sea". A propósito un campo APARTE de reciboMensajePie (arriba, tope
  // de 200 caracteres, pensado como despedida corta) — este es de largo
  // libre, sin ningún tope en el servidor (ver updateDatosTicket,
  // app/actions/tenant.ts) ni en la base (@db.Text de Postgres no tiene el
  // límite de ~10,485,760 caracteres de un varchar sin longitud declarada,
  // que de cualquier forma nunca se acercaría a alcanzar un ticket real).
  // null = no se imprime nada (sin regresión para quien no lo llene).
  reciboExtra String? @db.Text
  // 2026-09-26, tercera petición el mismo día: "podemos hacerlo
  // configurable. Que el cliente seleccione el tipo de salida que quiera.
  // Darle las opciones mas comunes y que el formato se adapte según el
  // seleccionado?" — el ticket (tanto el de recepción de una reparación
  // como el de cobro/venta, ver lib/recibo-imprimible.ts) no traía ninguna
  // regla @page de CSS, así que salía en el papel que el diálogo de
  // impresión del navegador tuviera por default, sin ajustarse al ancho
  // real de una impresora térmica de rollo. Default CARTA porque es el
  // comportamiento de SIEMPRE (sin @page fijo) — así ningún negocio
  // existente ve cambiar su ticket hasta que entre a Configuración y elija
  // el formato de su impresora real.
  reciboFormato ReciboFormato @default(CARTA)
  themePreset  ThemePreset @default(LUMIA_COBALT)

  // Intensidad de color del tema (2026-09-23, a petición de Carlos: "hazlas
  // personalizables para subir o bajar la intensidad de los colores", sobre
  // los 10 temas estilo Windows Phone/Metro de abajo). 0–200, 100 = la
  // paleta tal cual fue definida (ver WINDOWS_THEMES en lib/theme-presets.ts).
  // Escala SOLO la saturación de backgroundColor/tileColors, nunca el matiz
  // — así "más o menos vivo" nunca cambia DE QUÉ color se trata. Vive en el
  // tenant (no por sucursal, mismo criterio que cobrarEnDevolucion) porque
  // el tema es una decisión de marca de todo el negocio, no de una tienda en
  // particular.
  themeIntensity Int       @default(100)

  // Intensidad del FONDO / color primario (2026-09-24, a petición de Carlos:
  // "estoy complacido con el modulador de intensidad para las fichas, pero
  // también falta uno para el fondo o color primario ... podemos usar la
  // paleta RGB y según la selección, aplicar variaciones de 10% progresivos")
  // — segundo control, independiente de themeIntensity de arriba: ese solo
  // escala los 5 colores de ficha del POS, este solo escala backgroundColor
  // (ver construirPresetWindowsPhone en lib/theme-presets.ts). Mismo rango
  // 0–200 y mismo mecanismo (saturación en HSL), pero en pasos de 10% en la
  // UI en vez de 5%. Default 100 = ningún negocio existente cambia de
  // apariencia al agregar esta columna.
  themeIntensityFondo Int  @default(100)

  // Colores del tema "Personalizado" (2026-09-24, a petición de Carlos: "hay
  // que agregar un tema totalmente customizable. Elegir el color de fondo y
  // los colores secundarios" — reportó que el slider de intensidad de fondo
  // no hace nada visible en temas de fondo blanco/gris como "Windows 8
  // Start", porque escalar la saturación de un color sin saturación (blanco,
  // negro, gris) no cambia nada; un selector de color de verdad no tiene ese
  // problema). Solo tiene valor cuando themePreset = CUSTOM (ver el enum
  // abajo) — Json en vez de columnas sueltas por color para no tener que
  // agregar una migración cada vez que se ajusta la forma (ver
  // ColoresPersonalizados en lib/theme-presets.ts, que es quien de verdad
  // valida su forma antes de usarlo — nunca se confía en el contenido de un
  // campo Json tal cual). null = el negocio nunca ha configurado sus propios
  // colores (cae a COLORES_PERSONALIZADOS_DEFAULT si de todos modos elige
  // CUSTOM). Los 2 sliders de intensidad de arriba siguen aplicando sobre
  // estos colores igual que sobre cualquier otro tema.
  themeCustomColors Json?
  isActive     Boolean     @default(true)

  // Día en que abre la "semana laboral" de ESTE negocio (2026-09-18, a
  // petición explícita de Carlos: "no quiero que sea un sistema cerrado...
  // cada dueño debe poder crear su propio periodo laboral" — antes cada
  // módulo que hablaba de "esta semana" traía su propio criterio
  // improvisado y sin configurar: Dashboard usaba una ventana rodante de 7
  // días terminando hoy, Personal una ventana fija de 8 días, y Asistencia
  // otra ventana rodante de 7 días — ninguna alineada a un día real de
  // corte de nómina, y las tres podían mostrar números distintos entre sí
  // para la misma pregunta. 0=domingo … 6=sábado (mismo índice que
  // DIAS_SEMANA en lib/dashboard-data.ts). Default 1 = lunes, el criterio
  // que ya tenían las pantallas que sí usaban una semana calendario (ISO,
  // lunes a domingo) — así ningún tenant existente cambia de comportamiento
  // hasta que su dueño elija otro día en Configuración. Único punto de
  // verdad: lib/periodo-laboral.ts calcula el rango real a partir de este
  // campo, para que Dashboard/Personal/Asistencia dejen de tener cada uno
  // su propia idea de "semana".
  weekStartDay Int @default(1)

  // 2026-09-22, a petición de Carlos (ejemplo "Fix Expres"): si una
  // devolución (equipo diagnosticado y NO reparado) sí se cobra o no —
  // "en algunas partes si lo hacen. Asi que eso debe ser configurable desde
  // la pantalla del administrador". Explícitamente UNA sola regla para
  // TODO el negocio, no por sucursal (Carlos, al elegir entre las dos
  // opciones que se le presentaron). Default false = comportamiento de
  // siempre (devolución sin cargo) para cualquier tenant que ya existía
  // antes de este campo. Ver cobrarYEntregarAction/avanzarEstadoAction en
  // reparaciones-actions.ts para dónde se lee.
  cobrarEnDevolucion Boolean @default(false)

  // Monto fijo a cobrar por una devolución (2026-09-26, a petición de
  // Carlos, junto con la unificación del botón "Entregar" de Aduana/
  // Reparaciones: "hay que habilitar donde se activa la casilla un campo
  // para capturar en cuanto se cobraria la devolución"). Antes de esto,
  // activar cobrarEnDevolucion solo mandaba al cajero a POS SIN ningún
  // monto sugerido específico para el caso de devolución — reparaciones-data.ts
  // (getRepairParaCobro) usaba el mismo criterio que una reparación lista
  // (Repair.finalCost/estimatedCost), que no tiene sentido para un equipo
  // que nunca se reparó. Ahora ese caso usa este monto fijo por negocio
  // como sugerido en el carrito de POS (el cajero lo puede seguir ajustando
  // ahí mismo, ver POSClient.tsx). Solo tiene efecto cuando
  // cobrarEnDevolucion está activo; con la casilla apagada, la entrega de
  // una devolución siempre es $0.00 sin pasar por aquí.
  montoDevolucion Decimal @default(0) @db.Decimal(10, 2)

  // Qué categorías se muestran en la gráfica de pastel de "Ventas por
  // categoría" del Dashboard y de qué color — antes (2026-09-22, a
  // petición de Carlos, pendiente registrado) era solo estado del
  // navegador (useState en DashboardClient.tsx): se perdía cada vez que
  // recargaba la página. Guardado como JSON libre, no una tabla propia,
  // porque la clave es el NOMBRE de la categoría, no su id: el bucket
  // "Sin categoría" que arma getDashboardData (lib/dashboard-data.ts) no
  // tiene una fila de Category real detrás, así que no hay a qué
  // Category.id amarrar esta configuración. Forma: un arreglo de
  // {name, color, visible} — ver aplicarConfigCategorias en
  // lib/dashboard-data.ts. null = tenant que nunca ha guardado esta
  // config todavía → usa el default de siempre (las primeras 6 por monto
  // vendido este mes), para no cambiarle nada a un tenant existente hasta
  // que su dueño toque el modal de configuración.
  dashboardCategoriasConfig Json?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  // Límites de capacidad (cuántas sucursales, cuánto personal por sucursal)
  // que Carlos asigna/reasigna desde Panel Maestro — ver modelo PlanEsquema.
  // null = sin esquema asignado = sin límite (así quedan los tenants que ya
  // existían antes de este campo, para no romperles nada de golpe).
  esquemaId String?
  esquema   PlanEsquema? @relation(fields: [esquemaId], references: [id])

  branches     Branch[]
  users        User[]
  modules      TenantModule[]
  subscription Subscription?
  customers    Customer[]
  products     Product[]
  categories   Category[]
  repairs      Repair[]
  sales        Sale[]
  cashSessions CashSession[]
  staff        Staff[]
  suppliers    Supplier[]
  purchases    Purchase[]
  invoices     Invoice[]
  labels       TenantLabel[]
  supportTickets SupportTicket[]
  staffLoginSessions StaffLoginSession[]
  appointments Appointment[]
  patientRecords    PatientRecord[]
  clinicalNotes     ClinicalNote[]
  odontogramaTeeth  OdontogramaTooth[]
  treatmentPlans    TreatmentPlan[]
  informedConsents  InformedConsent[]
  prescriptions     Prescription[]
  notificaciones    Notificacion[]
  pushSubscriptions      PushSubscription[]
  solicitudesDispositivo SolicitudDispositivo[]
}

// Textos de UI personalizables por tenant (nombre del módulo, de la entidad,
// de cada estatus, etc.) sobre una clave interna fija que nunca cambia.
// Si un tenant no tiene fila para una key, el resolver cae al default del
// rubro (businessType) y, si tampoco existe, al default genérico del sistema
// — ambos niveles de default viven en código (lib/labels.ts), no en la BD.
model TenantLabel {
  id        String   @id @default(cuid())
  tenantId  String
  key       String
  value     String
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@unique([tenantId, key])
}

enum ThemePreset {
  // Presets originales (oklch) — se conservan sin borrar para no romper
  // ningún tenant que ya los tenga elegidos (ver el comentario largo junto a
  // THEME_PRESETS en lib/theme-presets.ts). Ya no se ofrecen en Configuración.
  NEUTRAL_TECH
  BLACK_GOLD
  EMERALD
  CORAL_WARM
  OCEAN_BLUE

  // Temas estilo Windows Phone/Metro (2026-09-24, a petición de Carlos — ver
  // WINDOWS_THEMES en lib/theme-presets.ts para el detalle completo de cada
  // uno). Agregados de forma aditiva, nunca se quitan ni renombran valores
  // de un enum ya usado por tenants reales.
  LUMIA_COBALT
  METRO_MAGENTA
  WINDOWS8_LIGHT
  SAPPHIRE_NIGHT
  MONOCHROME_METRO
  VIBRANT_LUMIA
  MANGO_TANGERINE
  LAWN_LIME
  DEEP_PLUM
  CRIMSON_START

  // "Personalizado" (2026-09-24, a petición de Carlos): en vez de una
  // paleta fija de WINDOWS_THEMES, el negocio elige sus propios 7 colores
  // (fondo, ícono/texto, 5 fichas), guardados en Tenant.themeCustomColors —
  // ver ColoresPersonalizados/construirPresetPersonalizado en
  // lib/theme-presets.ts.
  CUSTOM
}

// Formato de salida del ticket imprimible (2026-09-26, ver el comentario
// largo en Tenant.reciboFormato) — las tres opciones más comunes para un
// negocio pequeño en México: rollo térmico angosto, rollo térmico ancho (la
// más común en punto de venta), y hoja de oficina normal/PDF. Ver
// estilosImpresionTicket en lib/recibo-imprimible.ts para el CSS que arma
// cada una.
enum ReciboFormato {
  TERMICA_58
  TERMICA_80
  CARTA
}

model Branch {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  address   String?
  phone     String?
  // Sigla/código de sucursal (2026-09-22, a petición de Carlos, ejemplo
  // "Fix Expres": "una sigla distintiva o numero extra que identifique la
  // sucursal", asignada A MANO por el administrador al crear/editar la
  // sucursal — nunca autogenerada — porque el propio Carlos la define según
  // su propio criterio (ciudad, número de tienda, etc: "Tú la defines a
  // mano por sucursal"). Se usa para armar el folio de reparaciones (y de
  // ventas) de esa sucursal (ej. REP-MTY1-0001) para que un negocio con
  // varias sucursales pueda saber de un vistazo "la fuente del ingreso, ya
  // sea equipo o venta" sin tener que abrir el registro — ver el comentario
  // largo junto a la generación de folio en reparaciones-actions.ts y
  // pos-actions.ts. Opcional: una sucursal sin código asignado sigue
  // generando folios con el esquema viejo (sin prefijo) — "si es solo una
  // tienda no aplica" (Carlos), así ningún negocio existente con una sola
  // sucursal se ve obligado a definir uno.
  code      String?

  // Horario esperado de apertura/cierre de caja — Fase 2 de notificaciones
  // en tiempo real (2026-09-22, a petición de Carlos: "cuando se llegue
  // determinada hora y una sucursal no haya reportado apertura de caja o
  // que a la hora del cierre no hayan cerrado caja"). Ambos son opcionales
  // Y los dos deben estar capturados para que el cron (ver
  // app/api/cron/revisar-horarios-caja) revise esta sucursal — así ninguna
  // sucursal existente antes de este campo empieza a recibir alertas sin
  // que su dueño configure el horario primero. Formato "HH:MM" en 24h
  // (validado en sucursales-actions.ts), hora de America/Mexico_City —
  // única zona horaria que maneja hoy el proyecto (mismo criterio que
  // formatHoraLlegada/formatHoraCorta en lib/dashboard-data.ts) — ver
  // lib/horarios-sucursal.ts para toda la lógica de comparación.
  horaAperturaEsperada String?
  horaCierreEsperada   String?

  // Días de la semana que esta sucursal opera — 0=domingo … 6=sábado
  // (mismo índice que Tenant.weekStartDay, arriba). Si el día de hoy no
  // está en esta lista, el cron de horarios no revisa nada para esta
  // sucursal ese día. Default: los 7 días, para que definir el horario no
  // obligue también a definir los días — la mayoría de negocios opera
  // todos los días; el dueño desmarca manualmente el que no aplique (ej.
  // domingo).
  diasOperacion Int[] @default([0, 1, 2, 3, 4, 5, 6])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  users        User[]
  inventory    Inventory[]
  repairs      Repair[]
  sales        Sale[]
  cashSessions CashSession[]
  staff        Staff[]
  purchases    Purchase[]
  staffLoginSessions StaffLoginSession[]
  appointments Appointment[]
  treatmentPlans TreatmentPlan[]
  notificaciones Notificacion[]
  solicitudesDispositivo SolicitudDispositivo[]
}

// ============================================
// SUPERADMIN — PANEL MAESTRO
// ============================================

// Administradores de la plataforma (dueños de Linkity, no de un negocio en
// particular). Separado de User a propósito: User.tenantId es obligatorio
// (todo User pertenece a UN negocio), así que un admin de plataforma no se
// puede modelar como un User más sin volver ese campo opcional en todo el
// resto del sistema. Un superadmin inicia sesión con el mismo Supabase
// Auth que cualquier tenant (mismo login de siempre) — esta tabla es lo
// único que decide si esa sesión tiene permiso de entrar a /maestro/*.
// Se crea/promueve con scripts/set-superadmin.ts (no hay UI para esto
// todavía, a propósito: solo Carlos lo necesita por ahora).
model SuperAdmin {
  id         String   @id @default(cuid())
  supabaseId String   @unique
  email      String   @unique
  name       String
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())

  supportMessages SupportTicketMessage[]
}

// ============================================
// M3 - USUARIOS Y AUTENTICACIÓN
// ============================================

model User {
  id         String   @id @default(cuid())
  tenantId   String
  branchId   String?
  email      String
  name       String
  avatarUrl  String?
  supabaseId String   @unique
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  branch       Branch?       @relation(fields: [branchId], references: [id])
  role         UserRole?
  sales        Sale[]
  repairs      Repair[]
  // Named relations (2026-09-22, cambio de turno en Caja): CashSession
  // tiene dos FKs distintas a User (quién abrió y quién cerró la sesión),
  // así que Prisma exige nombrar cada lado para no confundirlas — mismo
  // motivo por el que abajo existe cashSessionsCerradas.
  cashSessions         CashSession[] @relation("CashSessionAbiertaPor")
  cashSessionsCerradas CashSession[] @relation("CashSessionCerradaPor")
  // Vínculo opcional con su registro de personal (M11) — permite atribuirle
  // a un empleado específico las ventas/reparaciones que hizo, para poder
  // calcular su comisión individual. No todo Staff tiene cuenta de acceso.
  staff        Staff?
  supportTickets  SupportTicket[]
  supportMessages SupportTicketMessage[]
  appointments    Appointment[]
  clinicalNotesWritten     ClinicalNote[]
  odontogramaTeethUpdated  OdontogramaTooth[]
  treatmentPlansCreated    TreatmentPlan[]
  informedConsentsTaken    InformedConsent[]
  prescriptionsWritten     Prescription[]
  // Suscripciones de notificaciones push del navegador de ESTE
  // administrador (2026-09-23, a petición de Carlos — ver el comentario
  // largo junto a PushSubscription, más abajo). Un mismo User puede tener
  // varias (su celular, su compu) — cada dispositivo que active
  // notificaciones se guarda aparte.
  pushSubscriptions PushSubscription[]
  // Solicitudes de dispositivo que ESTE administrador aprobó o rechazó
  // (SolicitudDispositivo.resueltoPor, 2026-09-23) — Prisma exige esta
  // relación de vuelta aunque nunca se consulte desde este lado; solo
  // sirve para poder guardar "quién resolvió cada solicitud" del otro lado.
  solicitudesDispositivoResueltas SolicitudDispositivo[]
  // Nota: StaffLoginSession NO se relaciona con User — apunta directo a
  // Staff, que es la identidad real detrás de una sesión de PIN (ver
  // comentario largo en ese modelo).

  @@unique([tenantId, email])
}

// ============================================
// M4 - ROLES Y PERMISOS
// ============================================

model Role {
  id          String   @id @default(cuid())
  tenantId    String
  name        String
  description String?
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())

  // 2026-09-22, a petición de Carlos (ejemplo "Fix Expres"): distingue al
  // "Jefe de técnicos" (ve TODAS las reparaciones asignadas en /taller, sin
  // poder editar nada) de un "Técnico reparador" normal (solo ve las que
  // tiene asignadas A ÉL — ver TallerClient.tsx). Default false = el
  // comportamiento de siempre (solo lo propio) para cualquier rol que ya
  // existía antes de este campo. Deliberadamente un booleano aparte, no un
  // módulo/permiso más: ambos puestos comparten exactamente el mismo módulo
  // ("taller") y la misma ruta — la única diferencia es CUÁNTO ve dentro de
  // esa misma pantalla de solo lectura, no A QUÉ pantalla puede entrar.
  verTodoTaller Boolean @default(false)

  // 2026-09-24, a petición de Carlos ("revisar la lógica del módulo Caja
  // por seguridad y evitar fraudes o posibles robos... ni empleado de
  // mostrador, cajera o técnico, debe conocer el monto de las ventas del
  // día"): un rol solo ve los montos/totales de Caja (efectivo esperado,
  // ventas del día, el panel de Detalle de movimientos, exportar reportes)
  // si tiene esto en true — sin él, puede seguir abriendo/cerrando caja y
  // registrando movimientos (conteo "a ciegas" al cerrar: cuenta el
  // efectivo físico sin ver antes cuánto "debería" haber, así un faltante
  // real sí se nota en vez de poder ajustarse para cuadrar con lo que ya
  // vio en pantalla), solo no ve las cifras agregadas. Mismo patrón que
  // verTodoTaller: un booleano de rol aparte, no un módulo más — "caja"
  // sigue siendo el mismo módulo para ambos niveles, la diferencia es
  // cuánto se le muestra dentro de esa misma pantalla. Default false — al
  // migrar, todo rol existente queda SIN ver montos salvo el rol semilla
  // "Gerente" (backfill aparte, ver prisma/migrar-permiso-montos-caja.ts);
  // cada negocio decide desde Personal → Roles y permisos a qué otros
  // roles (ej. "Encargada", "Supervisor") se lo vuelve a prender.
  verMontosCaja Boolean @default(false)

  // 2026-09-24, a petición de Carlos (redisño de puestos de reparación de
  // celulares: "Supervisor de Sucursales... audita inventarios... de las 5
  // tiendas... autoriza traslados de mercancía entre las 5 tiendas").
  // Mismo patrón que verTodoTaller/verMontosCaja: un booleano de rol
  // aparte, no un módulo más. Sin este campo, un empleado de PIN (sin
  // importar su rol) siempre queda limitado a los datos de SU PROPIA
  // sucursal en Reportes/Inventario/Caja (ver el comentario largo junto a
  // ActorResult.branchId, lib/actor.ts, y el "sucursalDeEmpleado" que cada
  // page.tsx de esos tres módulos ya aplicaba) — correcto para un
  // Encargado/Cajero de UNA tienda, pero rompe a un puesto de supervisión
  // que de verdad necesita ver/comparar las 5 sucursales a la vez. Cuando
  // es true, esos tres page.tsx (reportes, inventario, caja) dejan de
  // recortar por la sucursal asignada de este empleado — ve/opera
  // cualquier sucursal del negocio, igual que un administrador, pero SIN
  // ganar ningún módulo nuevo (sigue sin Personal/Facturación/
  // Configuración) ni el resto de sus restricciones (ej. sigue sin ver
  // montos de Caja salvo que verMontosCaja también esté en true). Default
  // false — ningún rol existente cambia de comportamiento al agregar este
  // campo.
  verTodoNegocio Boolean @default(false)

  userRoles   UserRole[]
  permissions RolePermission[]
  // Empleados de PIN (M11) que tienen este rol asignado — separado de
  // UserRole/userRoles (que es para cuentas con acceso completo vía
  // Supabase Auth: el dueño y, potencialmente, gerentes con correo propio).
  // Ver el comentario largo en Staff.roleId para la explicación completa de
  // por qué un empleado de PIN no usa User/UserRole.
  staff       Staff[]

  @@unique([tenantId, name])
}

model Permission {
  id          String  @id @default(cuid())
  module      String
  action      String
  description String?

  roles RolePermission[]

  @@unique([module, action])
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id])
  permission Permission @relation(fields: [permissionId], references: [id])

  @@id([roleId, permissionId])
}

model UserRole {
  userId String @unique
  roleId String

  user User @relation(fields: [userId], references: [id])
  role Role @relation(fields: [roleId], references: [id])
}

// ============================================
// M0 - MÓDULOS Y SUSCRIPCIONES
// ============================================

model Module {
  id          String  @id @default(cuid())
  code        String  @unique
  name        String
  description String?
  isCore      Boolean @default(false)

  tenants TenantModule[]
}

model TenantModule {
  tenantId  String
  moduleId  String
  isActive  Boolean  @default(true)
  enabledAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  module Module @relation(fields: [moduleId], references: [id])

  @@id([tenantId, moduleId])
}

model Subscription {
  id        String             @id @default(cuid())
  tenantId  String             @unique
  plan      String
  status    SubscriptionStatus @default(ACTIVE)
  startDate DateTime           @default(now())
  endDate   DateTime?
  price     Decimal            @db.Decimal(10, 2)
  currency  String             @default("MXN")
  // Vigencia contratada (1/3/6/12 meses) y si el cliente activó cobro
  // recurrente — de esto depende qué recordatorio le corresponde cerca
  // del vencimiento (aviso de próximo cobro automático vs. aviso de que
  // debe renovar a mano). El cálculo/envío de esos recordatorios y el
  // panel de vigencias en Panel Maestro son trabajo aparte, todavía no
  // construido — este cambio solo guarda los datos que ese trabajo va a
  // necesitar.
  billingCycle BillingCycle    @default(MENSUAL)
  autoRenew    Boolean         @default(false)

  // Ciclo de vida tras vencer sin renovar (2026-09-22, a petición de
  // Carlos, con plazos comparados contra prácticas de mercado: Google Play
  // da 7 días de gracia + hasta 60 de "espera" antes de cancelar; Shopify
  // conserva los datos de una tienda desactivada 2 años). Carlos definió
  // 4 avisos, todos contados en días desde `endDate`:
  //   día 0  → "tu suscripción venció, tienes 7 días de gracia" (acceso OK)
  //   día 7  → fin de gracia: ACCESO BLOQUEADO desde aquí (ver
  //            lib/ciclo-suscripcion.ts, calculado en vivo, no es un status
  //            aparte) + aviso de bloqueo/renovación
  //   día 30 → recordatorio de renovación (sigue bloqueada)
  //   día 90 → aviso de que su información se eliminará + Panel Maestro
  //            (Suscripciones) lo marca "lista para revisar" — Carlos
  //            decide a mano si la borra (nunca automático, ver
  //            eliminarTenantAction en maestro/tenants/actions.ts)
  // Cada campo guarda CUÁNDO se mandó ese aviso (null = todavía no se
  // manda) para que el cron de app/api/cron/revisar-suscripciones no lo
  // reenvíe cada día — los 4 se limpian al renovar (ver
  // renovarSuscripcionAction), así un negocio que vuelve a pagar arranca
  // el ciclo desde cero la próxima vez que venza.
  expiredNoticeSentAt   DateTime?
  blockNoticeSentAt     DateTime?
  renewalReminderSentAt DateTime?
  deletionNoticeSentAt  DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id])
}

enum SubscriptionStatus {
  ACTIVE
  SUSPENDED
  CANCELLED
  TRIAL
}

/**
 * Esquema de capacidad (2026-09) — reemplaza la idea de "el cliente elige
 * su plan" en el registro público: ahora el cobro y los paquetes/usuarios
 * adicionales los gestiona Hotmart por fuera de la plataforma, y aquí
 * dentro Carlos define cuántas sucursales y cuánto personal por sucursal
 * puede tener cada negocio — configurable desde Panel Maestro
 * (/maestro/esquemas), y reasignable en cualquier momento por tenant desde
 * su pantalla de detalle, para poder "migrar" a un cliente de esquema
 * según el volumen que vaya necesitando, sin tocar código ni base de datos
 * a mano.
 *
 * `isDefault` marca el esquema que se asigna automáticamente a un negocio
 * nuevo que se auto-registra (solo debe haber uno con isDefault=true a la
 * vez — las acciones en maestro/esquemas/actions.ts se encargan de eso).
 * `isActive=false` es un soft-delete: no se borra un esquema que ya tenga
 * tenants asignados (rompería su referencia), solo se oculta de la lista
 * para asignar esquemas nuevos.
 */
model PlanEsquema {
  id                String   @id @default(cuid())
  name              String
  maxBranches       Int
  maxStaffPerBranch Int
  isDefault         Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  tenants Tenant[]
}

enum BillingCycle {
  MENSUAL
  TRIMESTRAL
  SEMESTRAL
  ANUAL
}

// ============================================
// M6 - CATÁLOGO
// ============================================

model Category {
  id       String       @id @default(cuid())
  tenantId String
  name     String
  type     CategoryType
  color    String?
  parentId String?

  tenant   Tenant     @relation(fields: [tenantId], references: [id])
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]
}

enum CategoryType {
  PRODUCT
  PART
  SERVICE
}

model Product {
  id          String      @id @default(cuid())
  tenantId    String
  categoryId  String?
  sku         String?
  barcode     String?
  name        String
  description String?
  type        ProductType
  price       Decimal     @db.Decimal(10, 2)
  cost        Decimal?    @db.Decimal(10, 2)
  taxRate     Decimal     @default(16) @db.Decimal(5, 2)
  emoji       String?
  metadata    Json?
  isActive    Boolean     @default(true)
  // 2026-09-26, a petición de Carlos ("existe una mejor manera" que dejar
  // productos descontinuados nada más desactivados y olvidados en el
  // catálogo para siempre): archivedAt es un concepto DISTINTO de isActive.
  // isActive=false sigue significando "pausado, no se vende por ahora pero
  // puede regresar" (se sigue viendo en Catálogo, solo se esconde de
  // POS/Compras/Reparaciones — sin cambios). archivedAt!=null significa
  // "descontinuado de plano" — además de lo anterior, se esconde también de
  // la vista normal de Catálogo (CatalogoClient.tsx lo filtra salvo que el
  // usuario prenda "Ver archivados"), para que el catálogo del día a día no
  // crezca para siempre con productos que ya nadie va a volver a surtir.
  // Un producto archivado SIEMPRE tiene isActive=false también (ver
  // archivarProductoAction/restaurarProductoAction en catalogo-actions.ts,
  // que ponen/quitan ambos campos juntos) — nunca al revés: un producto
  // puede estar inactivo sin estar archivado, pero no archivado sin estar
  // inactivo.
  archivedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  category      Category?      @relation(fields: [categoryId], references: [id])
  inventory     Inventory[]
  saleItems     SaleItem[]
  repairItems   RepairItem[]
  purchaseItems PurchaseItem[]

  @@unique([tenantId, sku])
  @@unique([tenantId, barcode])
}

enum ProductType {
  PRODUCT
  PART
  SERVICE
}

// ============================================
// M12 - INVENTARIO
// ============================================

model Inventory {
  id        String   @id @default(cuid())
  productId String
  branchId  String
  stock     Int      @default(0)
  minStock  Int      @default(0)
  updatedAt DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])

  @@unique([productId, branchId])
}

// ============================================
// M7 - CLIENTES
// ============================================

model Customer {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  // Código de país del teléfono (ej. "+52", "+1") — lib/paises.ts trae el
  // catálogo. Default México porque es donde opera el negocio hoy; los
  // clientes creados antes de este campo quedan igual (México) al aplicar
  // el default vía `db push`, no hace falta backfill manual.
  phoneCountryCode String @default("+52")
  email     String?
  rfc       String?
  address   String?
  points    Int      @default(0)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant        @relation(fields: [tenantId], references: [id])
  sales        Sale[]
  repairs      Repair[]
  invoices     Invoice[]
  appointments Appointment[]
  patientRecord    PatientRecord?
  clinicalNotes    ClinicalNote[]
  odontogramaTeeth OdontogramaTooth[]
  treatmentPlans   TreatmentPlan[]
  informedConsents InformedConsent[]
  prescriptions    Prescription[]
}

// ============================================
// M8 - PUNTO DE VENTA
// ============================================

model Sale {
  id            String        @id @default(cuid())
  tenantId      String
  branchId      String
  customerId    String?
  userId        String
  folio         String
  subtotal      Decimal       @db.Decimal(10, 2)
  tax           Decimal       @db.Decimal(10, 2)
  discount      Decimal       @default(0) @db.Decimal(10, 2)
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod
  status        SaleStatus    @default(COMPLETED)
  notes         String?
  metadata      Json?
  createdAt     DateTime      @default(now())

  tenant        Tenant             @relation(fields: [tenantId], references: [id])
  branch        Branch             @relation(fields: [branchId], references: [id])
  customer      Customer?          @relation(fields: [customerId], references: [id])
  user          User               @relation(fields: [userId], references: [id])
  items         SaleItem[]
  invoice       Invoice?
  mixedPayments SaleMixedPayment[]

  @@unique([tenantId, folio])
}

model SaleItem {
  id        String  @id @default(cuid())
  saleId    String
  // productId ahora es opcional (2026-09-25, "Cobrar y entregar" de
  // Reparaciones ahora manda al cajero a POS en vez de cobrar aparte — a
  // petición explícita de Carlos: "lo debe mandar al POS para su cobro e
  // impresión del ticket correspondiente"). Antes, TODO renglón de una venta
  // era necesariamente un Product del catálogo — no existía forma de que una
  // venta de POS representara el cobro de una reparación (un monto
  // negociado, sin precio de lista ni control de stock). Un SaleItem ahora
  // es UNO de dos casos, nunca ambos ni ninguno (crearVentaAction, no la
  // base de datos, es quien valida "exactamente uno de productId/repairId"):
  // un producto/refacción/servicio del catálogo (productId, como siempre), o
  // el cobro de una reparación lista para entrega (repairId) — en ese caso
  // `price`/`subtotal` guardan el monto que el cajero cobró, validado contra
  // Repair.finalCost/estimatedCost en el servidor, nunca contra un precio de
  // catálogo.
  productId String?
  quantity  Int
  price     Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  subtotal  Decimal @db.Decimal(10, 2)
  repairId  String?

  sale    Sale     @relation(fields: [saleId], references: [id])
  product Product? @relation(fields: [productId], references: [id])
  repair  Repair?  @relation(fields: [repairId], references: [id])
}

// Desglose de una venta con método de pago "Mixto": un renglón por cada
// método realmente utilizado (ej. parte en efectivo, parte con tarjeta).
model SaleMixedPayment {
  id     String             @id @default(cuid())
  saleId String
  method MixedPaymentMethod
  amount Decimal            @db.Decimal(10, 2)

  sale Sale @relation(fields: [saleId], references: [id])
}

enum MixedPaymentMethod {
  CASH
  CARD
  TRANSFER
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  MIXED
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  REFUNDED
}

// ============================================
// M9 - TALLER Y REPARACIONES
// ============================================

model Repair {
  id            String       @id @default(cuid())
  tenantId      String
  branchId      String
  customerId    String
  userId        String
  folio         String
  deviceBrand   String
  deviceModel   String
  deviceSerial  String?
  issueDesc     String
  diagnosisDesc String?
  status        RepairStatus @default(RECEIVED)
  priority      Priority     @default(NORMAL)
  estimatedCost Decimal?     @db.Decimal(10, 2)
  finalCost     Decimal?     @db.Decimal(10, 2)
  receivedAt    DateTime     @default(now())
  estimatedAt   DateTime?
  deliveredAt   DateTime?
  publicToken   String       @unique @default(cuid())
  whatsappSent  Boolean      @default(false)
  notes         String?

  // Contraseña/patrón de desbloqueo del equipo (2026-09-24, a petición
  // explícita de Carlos: el Técnico de Reparación necesita verla para
  // poder trabajar el equipo — "solo puede ver... modelos y contraseñas de
  // desbloqueo"). Opcional (el cliente puede no traer bloqueo, o el
  // mostrador puede no haberla capturado) y deliberadamente NUNCA se
  // manda a la página pública de seguimiento (getReparacionPublica, lib/
  // reparaciones-data.ts) — es información sensible de acceso al
  // dispositivo, no algo que un tercero con el link público deba poder
  // ver.
  deviceUnlockCode String?

  // Técnico ASIGNADO para trabajar esta reparación (2026-09-21, a petición
  // de Carlos: "cuando se ingresa un equipo al terminar debe pasar esa
  // información al recien creado modulo de taller, donde le asignarán un
  // tecnico, eso no lo hacen desde tienda" — la asignación ocurre en
  // recepción/tienda, nunca desde el propio taller). Deliberadamente
  // distinto de `userId` (quien REGISTRÓ la reparación — encargado de
  // sucursal o recepcionista, ver el comentario de Repair.userId) y de
  // `tecnico` en ReparacionUI (que hoy en realidad muestra el nombre de
  // `user`, no un técnico real — ver reparaciones-data.ts). Null = todavía
  // sin asignar (el técnico no la ve en /taller hasta que se le asigna).
  // Opcional (`?`) por compatibilidad con toda reparación creada antes de
  // este cambio.
  assignedToStaffId String?
  assignedTo        Staff?  @relation("ReparacionesAsignadas", fields: [assignedToStaffId], references: [id])

  tenant   Tenant          @relation(fields: [tenantId], references: [id])
  branch   Branch          @relation(fields: [branchId], references: [id])
  customer Customer        @relation(fields: [customerId], references: [id])
  user     User            @relation(fields: [userId], references: [id])
  items    RepairItem[]
  history  RepairHistory[]
  // Renglón de una venta de POS que representa el cobro de ESTA reparación
  // (2026-09-25, ver el comentario largo en SaleItem.repairId) — en la
  // práctica cada reparación tiene a lo más uno (el cobro final, único), no
  // una lista real, pero Prisma exige el lado inverso del arreglo para poder
  // declarar la relación desde SaleItem.
  saleItems SaleItem[]

  @@unique([tenantId, folio])
}

model RepairItem {
  id        String  @id @default(cuid())
  repairId  String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(10, 2)

  repair  Repair  @relation(fields: [repairId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model RepairHistory {
  id        String       @id @default(cuid())
  repairId  String
  status    RepairStatus
  notes     String?
  createdAt DateTime     @default(now())

  // 2026-09-24, a petición de Carlos: quiere una página pública de
  // seguimiento (/rep/[publicToken]) donde el cliente vea el avance de su
  // equipo "similar a Amazon o DiDi Food" — SIN información sensible del
  // negocio (nunca costo de piezas por separado, nunca el nombre del
  // técnico, solo su puesto). En vez de inventar una tabla/modelo aparte
  // para esto, se reutiliza RepairHistory (que ya es el registro de TODO lo
  // que le pasa a una reparación) marcando cuáles de sus filas son
  // presentables al cliente. Default false = comportamiento de siempre
  // para cualquier fila ya existente (alertas de técnico, ajustes de costo)
  // — solo las transiciones de estatus reales, la asignación de técnico (sin
  // nombre, ver asignarTecnicoAction) y una alerta que el propio técnico
  // marque explícitamente "es para el cliente" (ver enviarAlertaTallerAction,
  // parámetro paraCliente) se marcan en true.
  visibleCliente Boolean @default(false)

  repair Repair @relation(fields: [repairId], references: [id])
}

enum RepairStatus {
  RECEIVED
  DIAGNOSING
  WAITING_PARTS
  IN_REPAIR
  READY
  DELIVERED
  CANCELLED
  WORKSHOP_READY
  WORKSHOP_RETURN
  SHOP_READY
  SHOP_RETURN
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ============================================
// M10 - CAJA
// ============================================

model CashSession {
  id             String            @id @default(cuid())
  tenantId       String
  branchId       String
  userId         String
  // 2026-09-22, a petición de Carlos ("cambio de turno" — dos empleados
  // que se turnan la misma caja en el día, ej. Sofía 9am-2pm y Martha
  // 2pm-9pm): antes solo se guardaba quién ABRIÓ la sesión, nunca quién la
  // CERRÓ — cualquiera con acceso a "caja" en esa sucursal podía cerrar una
  // sesión que abrió otra persona (correcto: es justo lo que permite el
  // cambio de turno) pero no quedaba registro de quién fue. Opcional
  // porque las sesiones ya cerradas antes de este cambio no tienen este
  // dato.
  closedByUserId String?
  openingCash  Decimal           @db.Decimal(10, 2)
  closingCash  Decimal?          @db.Decimal(10, 2)
  expectedCash Decimal?          @db.Decimal(10, 2)
  difference   Decimal?          @db.Decimal(10, 2)
  status       CashSessionStatus @default(OPEN)
  openedAt     DateTime          @default(now())
  closedAt     DateTime?
  notes        String?

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  branch    Branch         @relation(fields: [branchId], references: [id])
  user      User           @relation("CashSessionAbiertaPor", fields: [userId], references: [id])
  closedBy  User?          @relation("CashSessionCerradaPor", fields: [closedByUserId], references: [id])
  movements CashMovement[]
}

model CashMovement {
  id            String       @id @default(cuid())
  cashSessionId String
  type          MovementType
  amount        Decimal      @db.Decimal(10, 2)
  concept       String
  createdAt     DateTime     @default(now())

  cashSession CashSession @relation(fields: [cashSessionId], references: [id])
}

enum CashSessionStatus {
  OPEN
  CLOSED
}

enum MovementType {
  INCOME
  EXPENSE
}

// 2026-09-22, a petición de Carlos: panel de administrador "en tiempo real"
// — un dueño (1 sucursal o varias) debe poder enterarse de eventos
// importantes del negocio sin tener que ir a revisar cada módulo. Fase 1
// (esta): apertura/cierre de caja. Deliberadamente genérico (tipo +
// mensaje ya armado en texto, en vez de una tabla por tipo de evento) para
// poder agregar más tipos de aviso después (ej. "no reportaron apertura a
// tiempo", cuando exista horario configurable por sucursal — fase 2, aún
// sin construir) sin tener que rediseñar el modelo. Se guarda AQUÍ
// (persistido) además de mandarse por Supabase Realtime (ver
// lib/notificaciones.ts) para que quien no esté viendo la pantalla en el
// momento exacto lo vea después en la campanita — el realtime es solo el
// "y avísame ahora mismo si estoy viendo el panel", no la única copia.
model Notificacion {
  id        String           @id @default(cuid())
  tenantId  String
  // Opcional: un aviso podría no estar atado a una sucursal en particular
  // en el futuro (ej. algo a nivel negocio completo).
  branchId  String?
  tipo      NotificacionTipo
  mensaje   String
  leida     Boolean          @default(false)
  createdAt DateTime         @default(now())

  // Solo para tipo DISPOSITIVO_PENDIENTE (2026-09-23): a qué
  // SolicitudDispositivo aprobar/rechazar apuntan los botones de este
  // aviso en TenantShell.tsx. Nullable porque ningún otro tipo de
  // notificación lo usa. Guardarlo AQUÍ (no solo mandarlo por el broadcast
  // en vivo) es lo que permite que los botones de Aprobar/Rechazar sigan
  // funcionando si el administrador abre la campanita después, no solo en
  // el pop-up del momento.
  solicitudDispositivoId String?

  tenant Tenant  @relation(fields: [tenantId], references: [id])
  branch Branch? @relation(fields: [branchId], references: [id])
  solicitudDispositivo SolicitudDispositivo? @relation(fields: [solicitudDispositivoId], references: [id])

  @@index([tenantId, createdAt])
}

enum NotificacionTipo {
  CAJA_ABIERTA
  CAJA_CERRADA
  // Fase 2 (2026-09-22): incumplimiento de horario configurado en la
  // sucursal — ver app/api/cron/revisar-horarios-caja/route.ts y
  // Branch.horaAperturaEsperada/horaCierreEsperada arriba. A diferencia de
  // CAJA_ABIERTA/CAJA_CERRADA (que reportan un hecho que sí ocurrió), estos
  // dos reportan la AUSENCIA de un hecho a cierta hora — el front los pinta
  // en rojo/urgente para distinguirlos a simple vista (TenantShell.tsx).
  CAJA_NO_ABIERTA
  CAJA_NO_CERRADA
  // Fase 3 (2026-09-23, a petición de Carlos): un empleado intentó entrar
  // con su PIN desde un dispositivo que nunca se ha autorizado para su
  // sucursal (ver SolicitudDispositivo, más abajo). A diferencia de los
  // cuatro tipos de arriba (solo informativos), este SÍ trae una acción —
  // Aprobar/Rechazar — ver ESTILO_NOTIFICACION y el bloque de acción en
  // TenantShell.tsx.
  DISPOSITIVO_PENDIENTE
}

// 2026-09-23, a petición de Carlos ("que ningún empleado pueda entrar desde
// otro lugar y fingir que está en la tienda"): cada sucursal solo deja
// entrar PIN de personal desde un navegador ya autorizado para ELLA — ver
// crearConfianzaDispositivo/tieneConfianzaDispositivo en lib/staff-auth.ts.
// Esta tabla es la solicitud de autorización que se crea cuando un
// dispositivo nuevo lo intenta: queda PENDIENTE mientras el administrador
// no responde (por la notificación en tiempo real + push de su celular, o
// desde el listado de "Dispositivos pendientes" en Configuración), y el
// navegador que espera hace polling de su propio `token` (nunca del id, que
// sí queda visible en la lista del administrador) para saber cuándo
// aprobar/rechazar y seguir — o no — con el login.
model SolicitudDispositivo {
  id         String                     @id @default(cuid())
  tenantId   String
  branchId   String
  // Token opaco que solo conoce el navegador que hizo la solicitud —
  // separado del `id` (que sí es visible para el administrador en la
  // lista de pendientes) para que un navegador en espera nunca pueda, con
  // solo adivinar/probar ids, consultar ni resolver la solicitud de OTRO
  // dispositivo.
  token      String                     @unique
  status     SolicitudDispositivoStatus @default(PENDIENTE)
  userAgent  String?
  createdAt  DateTime                   @default(now())
  resueltoEn DateTime?
  // Quién la resolvió (administrador) — para dejar rastro de auditoría de
  // quién autorizó qué equipo.
  resueltoPorId String?

  tenant        Tenant  @relation(fields: [tenantId], references: [id])
  branch        Branch  @relation(fields: [branchId], references: [id])
  resueltoPor   User?   @relation(fields: [resueltoPorId], references: [id])
  notificaciones Notificacion[]

  @@index([tenantId, status, createdAt])
}

enum SolicitudDispositivoStatus {
  PENDIENTE
  APROBADO
  RECHAZADO
  // Nunca se borra una solicitud vieja no atendida — se marca vencida (ver
  // EXPIRACION_SOLICITUD_MS en lib/dispositivos-confianza.ts) para que el
  // administrador entienda en la lista por qué ya no puede resolverla,
  // en vez de que simplemente desaparezca.
  EXPIRADO
}

// Suscripción de notificaciones push del navegador (Web Push estándar —
// funciona en Chrome/Edge/Firefox de escritorio y Android directo; en
// iPhone requiere agregar la página a la pantalla de inicio primero, es
// una restricción de Apple, no de Linkity — ver el botón "Activar
// notificaciones" en Configuración). 2026-09-23, a petición de Carlos: que
// una solicitud de dispositivo pendiente (arriba) le suene al administrador
// aunque no tenga el panel abierto en ese momento, sin depender de WhatsApp
// ni de ninguna cuenta externa — el propio navegador ya trae esta función.
// Un mismo User puede tener varias filas (una por cada dispositivo donde
// activó notificaciones). Guarda el endpoint + llaves que entrega el propio
// navegador al suscribirse (ver guardarSuscripcionPushAction) — nunca datos
// de una cuenta de terceros, esto es 100% del propio navegador del usuario.
model PushSubscription {
  id        String   @id @default(cuid())
  tenantId  String
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@index([tenantId])
}

// ============================================
// M11 - PERSONAL
// ============================================

model Staff {
  id       String  @id @default(cuid())
  tenantId String
  branchId String
  // Cuenta interna de atribución (SIEMPRE se crea desde M11 en adelante,
  // por eso sigue siendo User y no Staff el que aparece en Sale.userId/
  // Repair.userId/CashSession.userId — cambiar esas 3 llaves foráneas para
  // apuntar a Staff habría sido una migración mucho más invasiva). Esta
  // cuenta NO es una cuenta de acceso real: se crea con un correo sintético
  // que nadie ve y un supabaseId inventado (nunca corresponde a una cuenta
  // real de Supabase Auth), así que jamás se puede usar para entrar por
  // /login — el empleado entra exclusivamente por /[tenant]/entrada con su
  // PIN (ver lib/staff-auth.ts). Sigue siendo opcional (`?`) solo por
  // compatibilidad con Staff sembrado antes de este cambio.
  userId   String? @unique
  name     String
  phone    String?
  email    String?
  position String?
  // PIN de 4 dígitos con el que el empleado entra a /[tenant]/entrada —
  // guardado con scrypt (lib/staff-auth.ts), nunca en texto plano. Null en
  // empleados que todavía no tienen PIN asignado (Staff sembrado antes de
  // este cambio, o un empleado que Carlos deliberadamente deja sin acceso
  // al sistema).
  pinHash  String?
  // Rol que determina a qué módulos puede entrar este empleado (ver
  // lib/roles.ts) — deliberadamente separado de Role.userRoles/UserRole
  // (que es para el dueño y cualquier cuenta con acceso completo vía
  // Supabase Auth). "Administrador" nunca se ofrece aquí como opción: ese
  // nivel de acceso solo existe a través de una cuenta real, no de un PIN.
  roleId   String?
  role     Role?   @relation(fields: [roleId], references: [id])

  // Código de país del teléfono (mismo patrón que Customer.phoneCountryCode,
  // ver lib/paises.ts) — 2026-09-17: antes el teléfono era texto libre sin
  // validar longitud, lo que permitía capturar más de los 10 dígitos que
  // exige México. Default México porque todo Staff creado antes de este
  // cambio opera ahí.
  phoneCountryCode String @default("+52")

  // Esquema de pago — 2026-09-17 (diversificación de puestos/rubros a
  // petición de Carlos): se agregó DESTAJO a PaymentScheme (pieceRate,
  // abajo) y se separó la frecuencia del sueldo de la de la comisión
  // (paymentFrequency ahora significa específicamente "frecuencia del
  // sueldo base"; commissionFrequency es la nueva, propia de la comisión —
  // ej. sueldo fijo semanal + comisión mensual, caso real que reportó
  // Carlos). Se agregó además un SEGUNDO par de comisión
  // (teamCommissionRate/teamCommissionBase) para el "jefe de equipo" que
  // cobra su propia comisión individual MÁS una comisión extra por
  // supervisar a los demás (ej. Jefe de Barberos) — calculada sobre la
  // producción de TODA la sucursal del empleado, no sobre una lista
  // explícita de "quién le reporta a quién" (simplificación deliberada: no
  // existe un organigrama en el sistema, y modelarlo sería un proyecto
  // aparte). teamCommissionBase null = "no lidera un equipo".
  paymentScheme       PaymentScheme    @default(FIJO)
  baseSalary          Decimal          @db.Decimal(10, 2)
  commissionRate      Decimal          @default(0) @db.Decimal(5, 2)
  commissionBase      CommissionBase   @default(VENTAS)
  paymentFrequency    PaymentFrequency @default(QUINCENAL)
  commissionFrequency PaymentFrequency @default(QUINCENAL)
  // Monto fijo por unidad de trabajo ("salario por unidad de obra" /
  // destajo) — solo tiene efecto cuando paymentScheme = DESTAJO. Qué cuenta
  // como "una unidad" lo decide commissionBase (VENTAS = por venta,
  // REPARACIONES = por reparación entregada); UTILIDAD no aplica a destajo.
  pieceRate           Decimal          @default(0) @db.Decimal(10, 2)
  teamCommissionRate  Decimal          @default(0) @db.Decimal(5, 2)
  teamCommissionBase  CommissionBase?
  // Método con el que se le paga a este empleado — determina si clabe es
  // obligatoria (ver validarDatosEmpleado en personal-actions.ts). Nombre
  // distinto de PaymentMethod (que ya existe para Sale.paymentMethod: CASH/
  // CARD/TRANSFER/MIXED, un catálogo de POS, no de nómina) para no pisar ese
  // enum ni forzarle valores que no le corresponden.
  staffPaymentMethod  StaffPaymentMethod @default(EFECTIVO)
  // CLABE interbancaria (18 dígitos exactos) — antes se asumía que TODA la
  // nómina se pagaba así; ahora solo se valida/exige cuando
  // staffPaymentMethod = TRANSFERENCIA (ver validarDatosEmpleado).
  clabe            String?

  hiredAt  DateTime @default(now())
  isActive Boolean  @default(true)

  tenant     Tenant         @relation(fields: [tenantId], references: [id])
  branch     Branch         @relation(fields: [branchId], references: [id])
  user       User?          @relation(fields: [userId], references: [id])
  attendances Attendance[]
  payments   StaffPayment[]
  loginSessions StaffLoginSession[]
  // Reparaciones que se le asignaron para trabajar en Taller — ver el
  // comentario largo de Repair.assignedToStaffId.
  reparacionesAsignadas Repair[] @relation("ReparacionesAsignadas")
}

enum PaymentScheme {
  FIJO
  COMISION
  MIXTO
  // Destajo / pago por unidad de obra (2026-09-17) — monto fijo por venta o
  // reparación entregada (Staff.pieceRate), no un porcentaje. Concepto real
  // y reconocido en la legislación laboral mexicana ("salario por unidad de
  // obra"), distinto de COMISION (que siempre es % sobre un monto).
  DESTAJO
}

enum CommissionBase {
  VENTAS
  REPARACIONES
  UTILIDAD
}

enum PaymentFrequency {
  SEMANAL
  // Catorcenal (cada 14 días) — 2026-09-17: frecuencia de nómina real y de
  // uso común en México junto con semanal/quincenal/mensual, agregada a
  // petición de Carlos para no excluir a negocios que pagan así.
  CATORCENAL
  QUINCENAL
  MENSUAL
}

// Método de pago de NÓMINA (Staff.staffPaymentMethod) — catálogo aparte del
// PaymentMethod de Sale (CASH/CARD/TRANSFER/MIXED, pensado para cobro en
// punto de venta). TRANSFERENCIA agrupa a propósito transferencia
// electrónica/SPEI y depósito bancario bajo un mismo valor: para efectos de
// este sistema (¿hay que pedir CLABE o no?) son el mismo caso.
enum StaffPaymentMethod {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  TARJETA_NOMINA
  OTRO
}

model Attendance {
  id       String    @id @default(cuid())
  staffId  String
  date     DateTime  @db.Date
  checkIn  DateTime?
  checkOut DateTime?
  notes    String?

  staff Staff @relation(fields: [staffId], references: [id])

  @@unique([staffId, date])
}

// Bitácora de asistencia basada en el login/logout REAL de personal por PIN
// (2026-09-16, a petición de Carlos). A propósito un modelo aparte de
// Attendance (arriba): Attendance es el registro MANUAL que ya alimenta
// horasSemana/nómina en Personal (un botón "Registrar entrada/salida" que
// cualquiera puede apretar sin estar realmente usando el sistema) — Carlos
// decidió dejarlo tal cual, sin tocar nómina, y que este nuevo panel de
// asistencia (/[tenant]/asistencia, solo visible para el administrador) sea
// puramente informativo y aparte, basado en cuándo el empleado de verdad
// entró/salió del sistema con su PIN.
//
// Una fila por CADA sesión de PIN (no una por día): un mismo empleado puede
// tener varios login/logout el mismo día (turno partido, o simplemente
// volver a entrar tras cerrar sesión) — por eso NO lleva un @@unique por
// día como Attendance. checkOut queda null mientras la sesión sigue
// abierta; se cierra por 3 caminos: (1) el empleado presiona "Cambiar de
// usuario" (closedBy MANUAL, ver cerrarSesionPersonalAction en
// acceso-personal-actions.ts), (2) el administrador la cierra a mano desde
// el panel (closedBy MANUAL también — ver cerrarAsistenciaManualAction en
// asistencia-actions.ts), o (3) el sistema detecta que ya es otro día
// calendario (México) la próxima vez que esa sesión intenta usarse, y la
// cierra sola en el instante justo antes de medianoche del día en que iba
// (closedBy DATE_ROLLOVER) — así nunca queda "abierta" más de un día,
// aunque el empleado deje la pestaña abierta o no cierre sesión (ver
// verificarSesionPersonalVigente en lib/asistencia.ts, que reemplaza a
// leerSesionPersonal en los dos lugares que validan esta sesión: el layout
// del tenant y resolverActor).
model StaffLoginSession {
  id        String                  @id @default(cuid())
  tenantId  String
  staffId   String
  branchId  String
  checkIn   DateTime                @default(now())
  checkOut  DateTime?
  closedBy  StaffLoginCloseReason?
  createdAt DateTime                @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])
  staff  Staff  @relation(fields: [staffId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])
}

enum StaffLoginCloseReason {
  MANUAL
  DATE_ROLLOVER
  // 2026-09-21, a petición de Carlos: cierre forzado cuando
  // verificarSesionPersonalVigente() (lib/asistencia.ts) detecta, en
  // cualquier request, que el Staff dueño de la sesión ya no está activo
  // (lo desactivaron desde Personal mientras tenía la sesión abierta).
  STAFF_INACTIVO
}

// Pagos de nómina efectivamente generados/dispersados a cada miembro del personal.
model StaffPayment {
  id               String             @id @default(cuid())
  staffId          String
  periodStart      DateTime           @db.Date
  periodEnd        DateTime           @db.Date
  baseAmount       Decimal            @db.Decimal(10, 2)
  commissionAmount Decimal            @default(0) @db.Decimal(10, 2)
  total            Decimal            @db.Decimal(10, 2)
  status           StaffPaymentStatus @default(PENDING)
  paidAt           DateTime?
  notes            String?
  createdAt        DateTime           @default(now())

  staff Staff @relation(fields: [staffId], references: [id])
}

enum StaffPaymentStatus {
  PENDING
  PAID
  CANCELLED
}

// ============================================
// M12 - PROVEEDORES Y COMPRAS
// ============================================

model Supplier {
  id        String   @id @default(cuid())
  tenantId  String
  name      String
  phone     String?
  email     String?
  rfc       String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  purchases Purchase[]
}

model Purchase {
  id         String         @id @default(cuid())
  tenantId   String
  supplierId String
  // Sucursal a la que se incrementa el Inventory cuando la compra pasa a
  // RECIBIDA. Opcional (no `branchId String` a secas) por la misma razón
  // que Staff.userId se dejó opcional: ya existe al menos una Purchase
  // sembrada (seed.ts) sin este campo, y agregarlo como requerido habría
  // disparado una advertencia de pérdida de datos en `prisma db push`. Toda
  // Purchase NUEVA sí exige branchId desde la Server Action
  // (crearCompraAction en compras-actions.ts) — el null solo puede
  // sobrevivir en registros sembrados antes de este cambio.
  branchId   String?
  folio      String
  total      Decimal        @db.Decimal(10, 2)
  status     PurchaseStatus @default(PENDING)
  notes      String?
  createdAt  DateTime       @default(now())
  // Cuándo se marcó como recibida (dispara el incremento de Inventory) —
  // mismo patrón que Repair.deliveredAt / CashSession.closedAt: un
  // timestamp de "cuándo pasó" además del status en sí.
  receivedAt DateTime?

  tenant   Tenant         @relation(fields: [tenantId], references: [id])
  supplier Supplier       @relation(fields: [supplierId], references: [id])
  branch   Branch?        @relation(fields: [branchId], references: [id])
  items    PurchaseItem[]

  @@unique([tenantId, folio])
}

model PurchaseItem {
  id         String  @id @default(cuid())
  purchaseId String
  productId  String
  quantity   Int
  cost       Decimal @db.Decimal(10, 2)
  subtotal   Decimal @db.Decimal(10, 2)

  purchase Purchase @relation(fields: [purchaseId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
}

enum PurchaseStatus {
  PENDING
  RECEIVED
  CANCELLED
}

// ============================================
// M14 - FACTURACIÓN CFDI
// ============================================

model Invoice {
  id         String        @id @default(cuid())
  tenantId   String
  customerId String
  saleId     String?       @unique
  folio      String
  uuid       String?       @unique
  cfdiXml    String?
  cfdiPdf    String?
  status     InvoiceStatus @default(PENDING)
  total      Decimal       @db.Decimal(10, 2)
  createdAt  DateTime      @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  sale     Sale?    @relation(fields: [saleId], references: [id])

  @@unique([tenantId, folio])
}

enum InvoiceStatus {
  PENDING
  STAMPED
  CANCELLED
}

// ============================================
// SOPORTE — TICKETS ENTRE NEGOCIO Y PANEL MAESTRO
// ============================================

// Un ticket lo abre siempre un User de negocio (nunca un SuperAdmin), pero
// cualquiera de los dos lados puede escribir mensajes dentro de él — por
// eso SupportTicketMessage tiene userId/superAdminId opcionales (uno u
// otro, nunca ambos; validado en la Server Action, no en el schema).
model SupportTicket {
  id       String              @id @default(cuid())
  tenantId String
  userId   String
  subject  String
  status   SupportTicketStatus @default(OPEN)
  // Reutiliza el mismo enum Priority de Reparaciones (M9) en vez de crear
  // uno nuevo — incluso valores como URGENT ya tienen sentido para un
  // ticket de soporte.
  priority  Priority @default(NORMAL)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  closedAt  DateTime?

  tenant   Tenant                 @relation(fields: [tenantId], references: [id])
  user     User                   @relation(fields: [userId], references: [id])
  messages SupportTicketMessage[]
}

model SupportTicketMessage {
  id           String   @id @default(cuid())
  ticketId     String
  userId       String?
  superAdminId String?
  body         String
  createdAt    DateTime @default(now())

  ticket     SupportTicket @relation(fields: [ticketId], references: [id])
  user       User?         @relation(fields: [userId], references: [id])
  superAdmin SuperAdmin?   @relation(fields: [superAdminId], references: [id])
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

// ============================================
// M15 - CITAS (AGENDA) — Fase 1 de "Propuesta: Consultorio Dental para
// Linkity" (2026-09-18): el módulo de Reparaciones no le sirve a un negocio
// de cita (dentista, médico, veterinaria, estética, spa, gimnasio, tatuajes,
// barbería) porque pide marca/modelo/falla de un APARATO — esos negocios
// necesitan agendar la atención de un PACIENTE/CLIENTE en un horario. Sigue
// el mismo patrón multi-tenant que Repair/Sale (tenantId propio, folio NO
// necesario aquí porque una cita no se factura por sí misma — ver notes de
// abajo). `userId` es la cuenta de atribución del profesional que atiende
// la cita, mismo criterio que Repair.userId/Sale.userId (ver el comentario
// largo en Staff.userId): en modo "staff" (sesión de PIN) resolverActor ya
// entrega el userId correcto, así que esta cita se puede atribuir a
// cualquier doctor/estilista/entrenador con PIN, no solo al dueño.
model Appointment {
  id         String            @id @default(cuid())
  tenantId   String
  branchId   String
  customerId String
  userId     String
  // Motivo breve de la cita (ej. "Limpieza dental", "Consulta general",
  // "Corte de cabello") — texto libre a propósito: a diferencia de
  // Repair.issueDesc (una falla reportada), aquí no hay un catálogo fijo de
  // motivos que aplique por igual a los 8 rubros de cita.
  reason    String
  status    AppointmentStatus @default(SCHEDULED)
  startsAt  DateTime
  endsAt    DateTime
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

// ============================================
// M16 - EXPEDIENTE CLÍNICO Y ODONTOGRAMA — Fase 1 de "Propuesta: Consultorio
// Dental para Linkity" (2026-09-18), items 2 y 3 del roadmap acordado con
// Carlos (después de M15-Citas). Cubre el mínimo que pide
// NOM-004-SSA3-2012 para un expediente clínico: antecedentes del paciente
// (una ficha que se acumula, no una por consulta) + notas de evolución (una
// por consulta/cita). El odontograma usa notación FDI de dos dígitos
// (cuadrante 1-4 + posición 1-8, ej. 11 = incisivo central superior
// derecho) — el estándar con el que cualquier dentista mexicano ya lee un
// odontograma en papel.
//
// Un solo módulo ("expediente-clinico", ver lib/modules-catalog.ts) cubre
// ambas piezas: no todo negocio de cita necesita el odontograma (dientes),
// pero antecedentes + notas de evolución sí le sirven a cualquier negocio
// de tipo consulta (médico, veterinaria), así que separarlo en dos módulos
// habría sido sobre-ingeniería para lo que pide esta fase — el odontograma
// simplemente no se muestra en la UI para un negocio cuyo businessType no
// es "consultorio_dental" (ver ClientesClient.tsx), sin necesidad de un
// segundo toggle. Todo vive embebido en la ficha del cliente (módulo
// Clientes, M7), no en una ruta propia — por eso ninguno de estos 3
// modelos necesita folio ni aparece en TenantShell.tsx como link de menú
// aparte.
model PatientRecord {
  id       String @id @default(cuid())
  tenantId String
  // Un expediente por paciente (no por cita) — se va acumulando con el
  // tiempo, de ahí el @unique en vez de permitir varios por Customer.
  customerId String @unique

  bloodType          String?
  allergies          String?
  chronicConditions  String?
  currentMedications String?
  previousSurgeries  String?
  familyHistory      String?
  generalNotes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
}

// Notas de evolución — una fila por consulta/visita, a diferencia de
// PatientRecord (un solo registro acumulado). `userId` es la cuenta de
// atribución del doctor/profesional que la escribió, mismo criterio que
// Appointment.userId/Repair.userId (ver el comentario largo en
// Staff.userId): cualquier doctor con PIN puede quedar como autor, no solo
// el dueño.
model ClinicalNote {
  id         String   @id @default(cuid())
  tenantId   String
  customerId String
  userId     String
  reason     String
  diagnosis  String?
  treatment  String?
  notes      String?
  createdAt  DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}

// Estado ACTUAL de cada diente del paciente — no existe una fila por cada
// diente de entrada: solo se crea/actualiza (upsert) cuando alguien cambia
// su condición desde "sano" (el default implícito que asume la UI cuando
// no hay fila, mismo criterio "sin fila = default" que ya usa TenantModule
// en este proyecto). `toothNumber` es el número FDI de dos dígitos
// (11-18, 21-28, 31-38, 41-48 para dentición permanente — Fase 1 no cubre
// dentición temporal/infantil, fuera de alcance de esta primera versión).
model OdontogramaTooth {
  id            String         @id @default(cuid())
  tenantId      String
  customerId    String
  toothNumber   Int
  condition     ToothCondition @default(SANO)
  notes         String?
  updatedAt     DateTime       @updatedAt
  updatedByUserId String?

  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  customer  Customer @relation(fields: [customerId], references: [id])
  updatedBy User?    @relation(fields: [updatedByUserId], references: [id])

  @@unique([customerId, toothNumber])
}

enum ToothCondition {
  SANO
  CARIES
  OBTURADO
  CORONA
  ENDODONCIA
  AUSENTE
  EXTRACCION_INDICADA
  IMPLANTE
  FRACTURADO
  SELLANTE
}

// ============================================
// M17 - PLAN DE TRATAMIENTO, CONSENTIMIENTO INFORMADO Y RECETAS — Fase 2 de
// "Propuesta: Consultorio Dental para Linkity" (2026-09-18), tres de los
// cuatro puntos de "Diferenciación comercial" (el cuarto, Reportes
// clínicos, no necesita modelos nuevos — lee estos de aquí). Igual que
// M16, vive embebido en la ficha del cliente (módulo Clientes, M7) bajo el
// mismo módulo "expediente-clinico" — no es exclusivo de consultorio
// dental (un consultorio médico también cotiza tratamientos por fases y
// receta medicamentos; una veterinaria también receta), así que ninguno de
// los 3 se condiciona a `businessType === "consultorio_dental"` como sí
// pasa con OdontogramaTooth arriba.
model TreatmentPlan {
  id         String   @id @default(cuid())
  tenantId   String
  // Igual que Repair/Appointment: fija en qué sucursal se cobra cada fase
  // (busca la CashSession abierta de ESA sucursal, ver
  // cobrarItemPlanAction en tratamiento-actions.ts) — no hace falta elegir
  // sucursal en cada cobro individual.
  branchId   String
  customerId String
  // Doctor que propone el plan — cuenta de atribución, mismo criterio que
  // ClinicalNote.userId/Appointment.userId (ver Staff.userId).
  userId     String
  title      String
  notes      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  branch   Branch              @relation(fields: [branchId], references: [id])
  customer Customer            @relation(fields: [customerId], references: [id])
  user     User                @relation(fields: [userId], references: [id])
  items    TreatmentPlanItem[]
}

// No hay status a nivel TreatmentPlan a propósito: la propuesta pide dar
// seguimiento a "qué propone el doctor vs. qué acepta el paciente"
// FASE POR FASE (ej. el paciente acepta la limpieza pero rechaza la
// corona) — un status único por plan perdería esa granularidad, así que
// PROPUESTO/ACEPTADO/RECHAZADO/PAGADO vive en cada item, y "tasa de
// aceptación" (Reportes clínicos) se calcula sobre items, no sobre planes.
//
// Sin tenantId propio ni entrada en getTenantPrisma/tenantModels (mismo
// criterio que RepairItem/SaleItem, ver el comentario largo de
// tenantModels en lib/prisma.ts): siempre se lee/escribe a través de un
// TreatmentPlan ya aislado por tenant, nunca por su cuenta.
model TreatmentPlanItem {
  id              String                  @id @default(cuid())
  treatmentPlanId String
  description     String
  // FDI, igual que OdontogramaTooth.toothNumber — opcional porque no todo
  // tratamiento es de un diente específico (ej. "Ortodoncia completa",
  // "Limpieza general").
  toothNumber     Int?
  cost            Decimal                 @db.Decimal(10, 2)
  status          TreatmentPlanItemStatus @default(PROPUESTO)
  order           Int                     @default(0)
  paidAt          DateTime?
  // Mismo enum PaymentMethod que ya usa Sale — es la misma "caja física"
  // del negocio la que recibe este cobro (ver cobrarTreatmentPlanItemAction
  // en expediente-actions.ts, calcado de cobrarYEntregarAction de
  // Reparaciones: solo CASH genera un CashMovement real).
  paymentMethod   PaymentMethod?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  treatmentPlan     TreatmentPlan      @relation(fields: [treatmentPlanId], references: [id])
  // Opcional — un consentimiento puede generarse suelto (ej. "tratamiento
  // general") o ligado a la fase específica del plan que lo motiva (ej. la
  // fase de "Extracción de tercer molar"). Ver InformedConsent más abajo.
  informedConsents InformedConsent[]
}

enum TreatmentPlanItemStatus {
  PROPUESTO
  ACEPTADO
  RECHAZADO
  PAGADO
}

// Consentimiento informado — NOM-004 lo exige para procedimientos con
// riesgo. `content` es el texto de la plantilla YA COPIADO al momento de
// generar el consentimiento (no una referencia a la plantilla): si Carlos
// edita el texto de una plantilla después, los consentimientos ya firmados
// no deben cambiar retroactivamente — es un documento legal congelado en
// el tiempo, igual que una factura ya timbrada no cambia si el catálogo de
// productos cambia después.
//
// `patientSignature` es una FIRMA DIBUJADA (canvas, PNG en base64) — no es
// una firma electrónica avanzada / e.firma del SAT ni tiene validez legal
// equivalente a una firma autógrafa notariada. Mismo criterio de
// "simulación honesta y documentada" que ya usa Linkity para CFDI (sin
// PAC/SAT real) — se lo advertimos a Carlos explícitamente, no es letra
// chica escondida.
model InformedConsent {
  id                String    @id @default(cuid())
  tenantId          String
  customerId        String
  userId            String
  procedureType     String
  content           String
  patientSignature  String?
  signedByName      String?
  signedAt          DateTime?
  // Opcional (ver el comentario en TreatmentPlanItem.informedConsents) — NO
  // es tenantId propio de este lado, es solo el vínculo narrativo; el
  // aislamiento por tenant lo sigue dando InformedConsent.tenantId de
  // siempre. Al igual que TreatmentPlanItem, verificar a mano en la Server
  // Action que el item (si viene) es del mismo tenant/paciente antes de
  // guardar.
  treatmentPlanItemId String?
  createdAt         DateTime  @default(now())

  tenant           Tenant             @relation(fields: [tenantId], references: [id])
  customer         Customer           @relation(fields: [customerId], references: [id])
  user             User               @relation(fields: [userId], references: [id])
  treatmentPlanItem TreatmentPlanItem? @relation(fields: [treatmentPlanItemId], references: [id])
}

// Receta digital. `medications` queda como texto libre (no una tabla
// estructurada de medicamento+dosis+frecuencia) — mismo criterio que
// ClinicalNote.notes: modelar eso a detalle es sobreingeniería para lo que
// pide esta fase, y un doctor ya está acostumbrado a escribir una receta
// como texto corrido. `doctorSignature` es la misma firma dibujada
// simulada que InformedConsent.patientSignature, ver ese comentario.
model Prescription {
  id               String   @id @default(cuid())
  tenantId         String
  customerId       String
  userId           String
  medications      String
  indications      String?
  doctorSignature  String?
  createdAt        DateTime @default(now())

  tenant   Tenant   @relation(fields: [tenantId], references: [id])
  customer Customer @relation(fields: [customerId], references: [id])
  user     User     @relation(fields: [userId], references: [id])
}